age')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_location/event_gps"><label>GPS coordinates</label></input></group><group appearance="field-list" ref="/data/sec1_context"><label>Extreme Event Context &amp; Recorder</label><input ref="/data/sec1_context/assessment_date"><label>Date of Event Assessment</label></input><input ref="/data/sec1_context/collector_id"><label>Observer ID (registered staff ID)</label><hint>Your registered staff ID, not your name</hint></input><select1 ref="/data/sec1_context/assessment_timing"><label>Assessment Timing</label><itemset nodeset="instance('assessment_timing')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/sec2_event"><label>Event Type &amp; Severity</label><input ref="/data/sec2_event/event_name"><label>Extreme event official name</label><hint>Common or administrative name of the extreme weather event</hint></input><input ref="/data/sec2_event/event_start_date"><label>Event start date</label><hint>Enter the date the event began.</hint></input><select1 ref="/data/sec2_event/event_type"><label>Extreme event type</label><itemset nodeset="instance('event_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_event/event_type_other"><label>Specify other event type</label></input><select1 ref="/data/sec2_event/event_severity"><label>Event severity scale</label><itemset nodeset="instance('severity')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_event/event_code_note"><label> **Event code:** <output value=" /data/sec2_event/event_code "/> (same for every assessment of this event) </label></input></group><group ref="/data/sec3_environment"><label>Impact on the Natural &amp; Aquatic Environment</label><select1 ref="/data/sec3_environment/vegetation_loss"><label>Vegetation loss / canopy damage</label><itemset nodeset="instance('vegetation_loss')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_environment/wetland_expansion"><label>Wetland expansion / flooding</label><itemset nodeset="instance('wetland')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_environment/soil_moisture"><label>Soil moisture change / drying</label><itemset nodeset="instance('soil_moisture')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_environment/other_env_impact"><label>Other environmental disruption</label><itemset nodeset="instance('yes_none')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_environment/other_env_impact_desc"><label>Describe the impact</label></input></group><group ref="/data/sec4_human"><label>Impact on Human Behaviour &amp; Displacement</label><select1 ref="/data/sec4_human/displacement"><label>Population displacement</label><itemset nodeset="instance('displacement')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec4_human/displaced_count"><label>Number of people displaced</label></input><select1 ref="/data/sec4_human/temporary_shelter"><label>Temporary shelter use</label><itemset nodeset="instance('shelter')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_human/sleeping_outdoors"><label>People sleeping outdoors</label><itemset nodeset="instance('sleeping_outdoors')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_human/livelihood_disrupted"><label>Livelihood &amp; daily activities disrupted</label><itemset nodeset="instance('livelihood')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_human/other_human_impact"><label>Other human behaviour impacts</label><itemset nodeset="instance('yes_none')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec4_human/other_human_impact_desc"><label>Describe the impact</label></input></group><group ref="/data/sec5_surveillance"><label>Surveillance Continuity &amp; Incident Log</label><select1 ref="/data/sec5_surveillance/trapping_continuity"><label>Entomological trapping continuity</label><itemset nodeset="instance('trapping_continuity')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec5_surveillance/traps_affected"><label>Sentinel trap stations affected</label><hint>Number of sentinel trap stations submerged, damaged, or inaccessible.</hint></input></group><input ref="/data/notes" appearance="multiline"><label>Observer incident remarks</label></input><group appearance="field-list" ref="/data/signature_info"><label>Signature</label><input ref="/data/signature_info/full_name_signature"><label>Full name (as signature)</label><hint>Type your full name</hint></input></group></h:body></h:html>