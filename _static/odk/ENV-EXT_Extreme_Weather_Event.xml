<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>ENV-EXT: Extreme Weather Event</h:title><model odk:xforms-version="1.0.0"><instance><data id="vg_env_ext" version="2026112015"><start/><end/><today/><deviceid/><username/><form_header/><sec1_location><node_code/><country/><province/><district/><event_locality/><event_gps/></sec1_location><sec1_context><assessment_date/><event_code/><observer_id/><assessment_timing/></sec1_context><sec2_event><q01_event_name/><q02_start_date/><q03_event_type/><q03_event_type_other/><q04_severity/></sec2_event><sec3_environment><q05_vegetation/><q06_wetland/><q07_soil/><q08_other_env/><q08_other_env_desc/></sec3_environment><sec4_human><q09_displacement/><q09_count/><q10_shelter/><q11_outdoors/><q12_livelihood/><q13_other_human/><q13_other_human_desc/></sec4_human><sec5_surveillance><q14_continuity/><q15_traps_affected/></sec5_surveillance><observer_remarks/><meta><instanceID/><instanceName/></meta></data></instance><instance id="yes_none"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="assessment_timing"><root><item><name>1</name><label>Immediate (within 48 hours)</label></item><item><name>2</name><label>Post-Event</label></item></root></instance><instance id="event_type"><root><item><name>1</name><label>Earthquake</label></item><item><name>2</name><label>Extreme temperature</label></item><item><name>3</name><label>Flood</label></item><item><name>4</name><label>Storm / Cyclones</label></item><item><name>5</name><label>Wildfire</label></item><item><name>6</name><label>Drought</label></item><item><name>7</name><label>Other (specify)</label></item></root></instance><instance id="severity"><root><item><name>1</name><label>Low</label></item><item><name>2</name><label>Moderate</label></item><item><name>3</name><label>Severe</label></item><item><name>4</name><label>Extreme</label></item></root></instance><instance id="vegetation_loss"><root><item><name>1</name><label>Yes (significant forest / shrub / crop canopy destroyed)</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="wetland"><root><item><name>1</name><label>Yes (extensive floodplains, ponds, or standing pools created)</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="soil_moisture"><root><item><name>1</name><label>Extreme saturation / mud</label></item><item><name>2</name><label>Extreme drought / cracked soil</label></item><item><name>0</name><label>Normal</label></item></root></instance><instance id="displacement"><root><item><name>1</name><label>Yes (residents displaced / evacuated from homes)</label></item><item><name>0</name><label>None displaced</label></item></root></instance><instance id="shelter"><root><item><name>1</name><label>Yes (displaced camps, school halls, or communal tents occupied)</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="sleeping_outdoors"><root><item><name>1</name><label>Yes (increased outdoor sleeping due to heat / structural collapse)</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="livelihood"><root><item><name>1</name><label>Yes (farming, school, markets, or cooking disrupted)</label></item><item><name>0</name><label>Normal routines</label></item></root></instance><instance id="trapping_continuity"><root><item><name>1</name><label>Trapping continuing normally</label></item><item><name>2</name><label>Partial operation</label></item><item><name>3</name><label>Full pause</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_location/node_code" type="string" required="true()"/><bind nodeset="/data/sec1_location/country" type="string" required="true()"/><bind nodeset="/data/sec1_location/province" type="string" required="true()"/><bind nodeset="/data/sec1_location/district" type="string" required="true()"/><bind nodeset="/data/sec1_location/event_locality" type="string" required="true()"/><bind nodeset="/data/sec1_location/event_gps" type="geopoint" required="true()"/><bind nodeset="/data/sec1_context/assessment_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future"/><setvalue ref="/data/sec1_context/assessment_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_context/event_code" type="string" required="true()"/><bind nodeset="/data/sec1_context/observer_id" type="string" required="true()"/><bind nodeset="/data/sec1_context/assessment_timing" type="string" required="true()"/><bind nodeset="/data/sec2_event/q01_event_name" type="string" required="true()"/><bind nodeset="/data/sec2_event/q02_start_date" type="date" required="true()" constraint=". &lt;=  /data/sec1_context/assessment_date " jr:constraintMsg="The event cannot start after the assessment date"/><bind nodeset="/data/sec2_event/q03_event_type" type="string" required="true()"/><bind nodeset="/data/sec2_event/q03_event_type_other" type="string" required="true()" relevant=" /data/sec2_event/q03_event_type ='7'"/><bind nodeset="/data/sec2_event/q04_severity" type="string" required="true()"/><bind nodeset="/data/sec3_environment/q05_vegetation" type="string" required="true()"/><bind nodeset="/data/sec3_environment/q06_wetland" type="string" required="true()"/><bind nodeset="/data/sec3_environment/q07_soil" type="string" required="true()"/><bind nodeset="/data/sec3_environment/q08_other_env" type="string" required="true()"/><bind nodeset="/data/sec3_environment/q08_other_env_desc" type="string" required="true()" relevant=" /data/sec3_environment/q08_other_env ='1'"/><bind nodeset="/data/sec4_human/q09_displacement" type="string" required="true()"/><bind nodeset="/data/sec4_human/q09_count" type="int" required="true()" constraint=". &gt;= 1" relevant=" /data/sec4_human/q09_displacement ='1'"/><bind nodeset="/data/sec4_human/q10_shelter" type="string" required="true()"/><bind nodeset="/data/sec4_human/q11_outdoors" type="string" required="true()"/><bind nodeset="/data/sec4_human/q12_livelihood" type="string" required="true()"/><bind nodeset="/data/sec4_human/q13_other_human" type="string" required="true()"/><bind nodeset="/data/sec4_human/q13_other_human_desc" type="string" required="true()" relevant=" /data/sec4_human/q13_other_human ='1'"/><bind nodeset="/data/sec5_surveillance/q14_continuity" type="string" required="true()"/><bind nodeset="/data/sec5_surveillance/q15_traps_affected" type="int" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/observer_remarks" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec1_context/event_code , &quot; - &quot;,  /data/sec1_context/assessment_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># ENV-EXT: Extreme Weather Event</label></input><group appearance="field-list" ref="/data/sec1_location"><label>Section 1A: Administrative geography &amp; location</label><input ref="/data/sec1_location/node_code"><label>Node Code</label></input><input ref="/data/sec1_location/country"><label>Country</label></input><input ref="/data/sec1_location/province"><label>Province</label></input><input ref="/data/sec1_location/district"><label>District</label></input><input ref="/data/sec1_location/event_locality"><label>Event Village / Locality</label></input><input ref="/data/sec1_location/event_gps"><label>GPS coordinates</label></input></group><group appearance="field-list" ref="/data/sec1_context"><label>Section 1B: Extreme event context &amp; recorder</label><input ref="/data/sec1_context/assessment_date"><label>Date of Event Assessment</label></input><input ref="/data/sec1_context/event_code"><label>Event Unique Code</label><hint>EVT-...</hint></input><input ref="/data/sec1_context/observer_id"><label>Field observer / team ID</label></input><select1 ref="/data/sec1_context/assessment_timing"><label>Assessment Timing</label><itemset nodeset="instance('assessment_timing')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/sec2_event"><label>Section 2: Event type &amp; severity</label><input ref="/data/sec2_event/q01_event_name"><label>Q01. Extreme event official name</label><hint>Common or administrative name of the extreme weather event</hint></input><input ref="/data/sec2_event/q02_start_date"><label>Q02. Event start date</label><hint>Enter the date the event began.</hint></input><select1 ref="/data/sec2_event/q03_event_type"><label>Q03. Extreme event type</label><itemset nodeset="instance('event_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_event/q03_event_type_other"><label>Q03. Specify other event type</label></input><select1 ref="/data/sec2_event/q04_severity"><label>Q04. Event severity scale</label><itemset nodeset="instance('severity')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/sec3_environment"><label>Section 3: Impact on the natural &amp; aquatic environment</label><select1 ref="/data/sec3_environment/q05_vegetation"><label>Q05. Vegetation loss / canopy damage</label><itemset nodeset="instance('vegetation_loss')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_environment/q06_wetland"><label>Q06. Wetland expansion / flooding</label><itemset nodeset="instance('wetland')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_environment/q07_soil"><label>Q07. Soil moisture change / drying</label><itemset nodeset="instance('soil_moisture')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_environment/q08_other_env"><label>Q08. Other environmental disruption</label><itemset nodeset="instance('yes_none')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_environment/q08_other_env_desc"><label>Q08. Describe the impact</label></input></group><group ref="/data/sec4_human"><label>Section 4: Impact on human behaviour &amp; displacement</label><select1 ref="/data/sec4_human/q09_displacement"><label>Q09. Population displacement</label><itemset nodeset="instance('displacement')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec4_human/q09_count"><label>Q09. Number of people displaced</label></input><select1 ref="/data/sec4_human/q10_shelter"><label>Q10. Temporary shelter utilization</label><itemset nodeset="instance('shelter')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_human/q11_outdoors"><label>Q11. People sleeping outdoors</label><itemset nodeset="instance('sleeping_outdoors')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_human/q12_livelihood"><label>Q12. Livelihood &amp; daily activities disrupted</label><itemset nodeset="instance('livelihood')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_human/q13_other_human"><label>Q13. Other human behaviour impacts</label><itemset nodeset="instance('yes_none')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec4_human/q13_other_human_desc"><label>Q13. Describe the impact</label></input></group><group ref="/data/sec5_surveillance"><label>Section 5: Surveillance continuity &amp; incident log</label><select1 ref="/data/sec5_surveillance/q14_continuity"><label>Q14. Entomological trapping continuity</label><itemset nodeset="instance('trapping_continuity')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec5_surveillance/q15_traps_affected"><label>Q15. Sentinel trap stations affected</label><hint>Number of sentinel trap stations submerged, damaged, or inaccessible.</hint></input></group><input ref="/data/observer_remarks" appearance="multiline"><label>Observer incident remarks</label></input></h:body></h:html>