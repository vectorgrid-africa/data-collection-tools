lculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '2'])"/><bind nodeset="/data/predator3_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '3'])"/><bind nodeset="/data/predator4_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '4'])"/><bind nodeset="/data/predator5_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '5'])"/><bind nodeset="/data/predator6_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '6'])"/><bind nodeset="/data/predator7_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '7'])"/><bind nodeset="/data/predator8_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '8'])"/><bind nodeset="/data/predator9_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '9'])"/><bind nodeset="/data/predator10_total" type="string" calculate="sum( /data/samples/predators/predator_counts/predator_count [../predator_code = '10'])"/><bind nodeset="/data/totals_note" readonly="true()" type="string"/><bind nodeset="/data/sec6_predators" readonly="true()" type="string"/><bind nodeset="/data/sec7_archiving/q25_sample_collected" type="string" required="true()"/><bind nodeset="/data/sec7_archiving/q25_reason" type="string" required="true()" relevant=" /data/sec7_archiving/q25_sample_collected ='0' and ( /data/sec4_effort/q21_larvae ='1' or  /data/sec4_effort/q21_pupae ='1')"/><bind nodeset="/data/sec7_archiving/q26_preservation" type="string" required="true()" relevant=" /data/sec7_archiving/q25_sample_collected ='1'"/><bind nodeset="/data/sec7_archiving/q27_vial_id" type="string" required="true()" relevant=" /data/sec7_archiving/q25_sample_collected ='1'"/><bind nodeset="/data/sec7_archiving/q28_photo" type="string" required="true()"/><bind nodeset="/data/sec7_archiving/suggested_file_name" type="string" calculate="concat( /data/habitat_id , &quot;_&quot;, format-date( /data/sec1_event/survey_date , &quot;%Y%m%d&quot;))"/><bind nodeset="/data/sec7_archiving/q28_file_name" type="string" required="true()" relevant=" /data/sec7_archiving/q28_photo ='1'"/><bind nodeset="/data/observer_comments" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/habitat_id , &quot; - &quot;,  /data/sec1_event/survey_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># HAB-SRV: Habitat Survey and Dipping</label></input><group appearance="field-list" ref="/data/sec1_links"><label>Section 1A: Study node &amp; site links</label><input ref="/data/sec1_links/village"><label>Site / Village ID</label><hint>Type it as on HAB-REG; the habitat list is filtered by it.</hint></input><select1 ref="/data/sec1_links/sample_unit"><label>Habitat or container?</label><itemset nodeset="instance('sample_unit')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec1_links/habitat" appearance="search"><label>Habitat ID</label><itemset nodeset="instance('habitats')/root/item[village= /data/sec1_links/village  and status=&quot;active&quot;]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_links/container_id"><label>Container ID</label></input><input ref="/data/sec1_links/compound_id"><label>For containers: household / compound ID</label></input><input ref="/data/sec1_links/node_code_typed"><label>Node Code</label></input><input ref="/data/sec1_links/visit_id"><label>Visit ID</label></input><input ref="/data/sec1_links/survey_time"><label>Survey Time</label></input></group><input ref="/data/habitat_note"><label> Node: <output value=" /data/node_code "/> | Habitat / container: <output value=" /data/habitat_id "/> </label></input><group appearance="field-list" ref="/data/sec1_event"><label>Section 1B: Dipping survey event &amp; habitat characteristics</label><input ref="/data/sec1_event/survey_date"><label>Survey Date</label></input><select1 ref="/data/sec1_event/surveillance_type"><label>Surveillance type</label><itemset nodeset="instance('surveillance_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_event/collector_id"><label>Collector / team ID</label></input><select1 ref="/data/sec1_event/season"><label>Season</label><itemset nodeset="instance('season')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_event/season_other"><label>Specify other season</label></input></group><group ref="/data/sec2_water"><label>Section 2: Water physico-chemical parameters</label><input ref="/data/sec2_water/q01_water_temp"><label>Q01. Water temperature (°C)</label><hint>Measured surface water temperature</hint></input><input ref="/data/sec2_water/q02_ph"><label>Q02. pH</label><hint>Hydrogen ion concentration (water pH level)</hint></input><input ref="/data/sec2_water/q03_conductivity"><label>Q03. Electrical conductivity (μS/cm)</label><hint>Total dissolved ionic conductivity in water</hint></input><input ref="/data/sec2_water/q04_salinity"><label>Q04. Salinity (if measured) - value</label><hint>Enter the reading and unit reported by the meter.</hint></input><input ref="/data/sec2_water/q04_salinity_unit"><label>Q04. Salinity - unit</label></input><input ref="/data/sec2_water/q05_tds"><label>Q05. Total dissolved solids (mg/L)</label><hint>Mass concentration of dissolved mineral particles</hint></input><input ref="/data/sec2_water/q06_oxygen"><label>Q06. Dissolved oxygen (mg/L)</label><hint>Concentration of dissolved oxygen in water</hint></input><select1 ref="/data/sec2_water/q07_movement"><label>Q07. Water movement</label><itemset nodeset="instance('water_movement')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_water/q08_colour"><label>Q08. Water colour</label><itemset nodeset="instance('water_colour')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_water/q08_colour_other"><label>Q08. Specify other water colour</label></input><select1 ref="/data/sec2_water/q09_source"><label>Q09. Water source origin</label><itemset nodeset="instance('water_source')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/sec3_habitat"><label>Section 3: Habitat vegetation &amp; surrounding environment</label><input ref="/data/sec3_habitat/q10_length"><label>Q10. Habitat surface length (m)</label><hint>Record maximal length and perpendicular width across water body</hint></input><input ref="/data/sec3_habitat/q10_width"><label>Q10. Habitat surface width (m)</label></input><input ref="/data/sec3_habitat/q11_perimeter"><label>Q11. Habitat perimeter (m)</label><hint>Distance around the water's edge at this visit.</hint></input><input ref="/data/sec3_habitat/q12_area"><label>Q12. Estimated surface area (m²)</label><hint> Total water surface area (Length × Width approximation: <output value=" /data/sec3_habitat/area_lw "/> m²) </hint></input><input ref="/data/sec3_habitat/q13_depth"><label>Q13. Average water depth (cm)</label><hint>Measured vertical depth of water column in centimetres</hint></input><select1 ref="/data/sec3_habitat/q14_shade"><label>Q14. Shade over habitat</label><itemset nodeset="instance('shade')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_habitat/q19_canopy_cover"><label>Q19. Canopy cover this visit (%)</label><hint>Estimated percentage of the habitat under canopy</hint></input><input ref="/data/sec3_habitat/q19_biofilm_cover"><label>Q19. Biofilm cover this visit (%)</label><hint>Visual percentage estimate of water surface covered by biofilm. Enter 0 if none.</hint></input><select1 ref="/data/sec3_habitat/q15_veg_type"><label>Q15. Vegetation type</label><itemset nodeset="instance('vegetation_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_habitat/q15_veg_type_other"><label>Q15. Specify other vegetation type</label></input><select1 ref="/data/sec3_habitat/q16_veg_qty"><label>Q16. Vegetation quantity</label><itemset nodeset="instance('vegetation_qty')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_habitat/q19_veg_cover"><label>Q19. Vegetation cover this visit (%)</label><hint>Visual percentage estimate of water surface occupied by vegetation</hint></input><select1 ref="/data/sec3_habitat/q17_algae_qty"><label>Q17. Algal quantity</label><itemset nodeset="instance('algae_qty')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_habitat/q18_algae_type"><label>Q18. Algae type</label><itemset nodeset="instance('algae')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_habitat/q18_algae_type_other"><label>Q18. Specify other algae type</label></input><input ref="/data/sec3_habitat/q19_algae_cover"><label>Q19. Algae cover this visit (%)</label><hint>Visual percentage estimate of water surface covered by algae</hint></input><select1 ref="/data/sec3_habitat/q20_environment"><label>Q20. Environment around habitat</label><itemset nodeset="instance('environment')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_habitat/q20_environment_other"><label>Q20. Specify other environment</label></input></group><group ref="/data/sec4_effort"><label>Section 4: Larval sampling protocol &amp; sampling effort</label><select1 ref="/data/sec4_effort/q21_larvae"><label>Q21. Larvae observed in habitat</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_effort/q21_pupae"><label>Q21. Pupae observed in habitat</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_effort/q22_predators"><label>Q22. Aquatic predators observed</label><itemset nodeset="instance('predators_observed')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec4_effort/q23_method"><label>Q23. Sampling technique deployed</label><itemset nodeset="instance('sampling_method')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec4_effort/q24_samples"><label>Q24. Completed dips / buckets / samples</label><hint>Record completed dips, buckets or samples for the Q23 method.</hint></input><input ref="/data/sec4_effort/q24_sections"><label>Q24. Number of habitat sections sampled</label></input><input ref="/data/sec4_effort/q24a_reason"><label>Q24a. Reason for fewer dips</label><hint>For standard dipping, if fewer than 10 were completed, record why.</hint></input></group><input ref="/data/sec5_note"><label>## Section 5: Completed samples and taxon counts

One entry per completed dip, bucket or container examination. Keep each empty sample with zero taxa. Within a sample, add counts by taxon. Record predators once per sample.</label></input><group ref="/data/samples"><label>Sample</label><repeat nodeset="/data/samples" jr:count=" /data/sec4_effort/q24_samples "><input ref="/data/samples/num_taxa"><label> Sample <output value=" ../sample_no "/>: number of taxa found </label><hint>0 for an empty sample</hint></input><group ref="/data/samples/taxa"><label>Taxon counts</label><repeat nodeset="/data/samples/taxa" jr:count=" ../num_taxa "><group appearance="field-list" ref="/data/samples/taxa/taxon_counts"><label> Sample <output value=" ../../sample_no "/>: taxon </label><select1 ref="/data/samples/taxa/taxon_counts/taxon_code"><label>Taxon code</label><itemset nodeset="instance('taxon')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/samples/taxa/taxon_counts/taxon_name"><label>Taxon name</label></input><input ref="/data/samples/taxa/taxon_counts/count_l12"><label>L1-L2</label></input><input ref="/data/samples/taxa/taxon_counts/count_l3"><label>L3</label></input><input ref="/data/samples/taxa/taxon_counts/count_l4"><label>L4</label></input><input ref="/data/samples/taxa/taxon_counts/count_pupae"><label>Pupae</label></input><input ref="/data/samples/taxa/taxon_counts/taxon_larvae_note"><label> Total larvae: <output value=" ../taxon_larvae "/> </label></input></group></repeat></group><input ref="/data/samples/num_predator_types"><label> Sample <output value=" ../sample_no "/>: number of predator types found </label></input><group ref="/data/samples/predators"><label>Predator counts</label><repeat nodeset="/data/samples/predators" jr:count=" ../num_predator_types "><group appearance="field-list" ref="/data/samples/predators/predator_counts"><label> Sample <output value=" ../../sample_no "/>: predator </label><select1 ref="/data/samples/predators/predator_counts/predator_code"><label>Predator code</label><itemset nodeset="instance('predator')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/samples/predators/predator_counts/predator_count"><label>Count</label></input></group></repeat></group></repeat></group><input ref="/data/totals_note"><label> ## Totals

Total larvae: <output value=" /data/total_larvae "/> | Pupae: <output value=" /data/total_pupae "/> | **Larvae per completed dip / sample: <output value=" /data/larvae_per_sample "/>**

An. gambiae s.l.: <output value=" /data/taxon1_larvae "/> | An. funestus group: <output value=" /data/taxon2_larvae "/> | Other Anopheline: <output value=" /data/taxon3_larvae "/> | Culex: <output value=" /data/taxon4_larvae "/> | Aedes: <output value=" /data/taxon5_larvae "/> | Mansonia: <output value=" /data/taxon6_larvae "/> | Other (write name): <output value=" /data/taxon7_larvae "/> </label></input><input ref="/data/sec6_predators"><label> ## Section 6: Aquatic predator totals

Dragonfly (DF): <output value=" /data/predator1_total "/> | Damselfly (DS): <output value=" /data/predator2_total "/> | Diving Beetle (DB): <output value=" /data/predator3_total "/> | Backswimmer (BS): <output value=" /data/predator4_total "/> | Water Boatman (WB): <output value=" /data/predator5_total "/> | Water Scorpion (WS): <output value=" /data/predator6_total "/> | Giant Water Bug (GB): <output value=" /data/predator7_total "/> | Tadpole (TP): <output value=" /data/predator8_total "/> | Copepod (CP): <output value=" /data/predator9_total "/> | Other Predators (OT): <output value=" /data/predator10_total "/> </label></input><group ref="/data/sec7_archiving"><label>Section 7: Specimen preservation &amp; field archiving</label><select1 ref="/data/sec7_archiving/q25_sample_collected"><label>Q25. Sample collected for lab analysis</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec7_archiving/q25_reason"><label>Q25. Reason none retained</label><hint>Immatures were found but none were retained.</hint></input><select1 ref="/data/sec7_archiving/q26_preservation"><label>Q26. Preservation method applied</label><itemset nodeset="instance('preservation')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec7_archiving/q27_vial_id"><label>Q27. Sample tube / vial ID</label><hint>Country-Node-Larv-ID. Link any reared adults to this vial and visit on SPEC-SRT.</hint></input><select1 ref="/data/sec7_archiving/q28_photo"><label>Q28. Habitat photograph taken</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec7_archiving/q28_file_name"><label>Q28. File name</label><hint> HabitatID_YYYYMMDD, e.g. <output value=" /data/sec7_archiving/suggested_file_name "/> </hint></input></group><input ref="/data/observer_comments" appearance="multiline"><label>Observer field comments</label></input></h:body></h:html>