<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:entities="http://www.opendatakit.org/xforms/entities"><h:head><h:title>HAB-UPD: Habitat Status Update</h:title><model odk:xforms-version="1.0.0" entities:entities-version="2024.1.0"><instance><data id="vg_hab_upd" version="2026112015"><start/><end/><today/><deviceid/><username/><form_header/><sec1_habitat><village/><habitat/><node_code/><habitat_id/><previous_status/><habitat_note/></sec1_habitat><sec1_update><update_date/><collector_id/></sec1_update><sec2_status><q01_status/><q02_reason/><q02_reason_other/><q03_notes/></sec2_status><full_name_signature/><status/><meta><entity dataset="habitats" update="1" baseVersion="" trunkVersion="" branchId="" id=""/><instanceID/><instanceName/></meta></data></instance><instance id="habitats" src="jr://file-csv/habitats.csv"/><instance id="habitat_status"><root><item><name>1</name><label>Active</label></item><item><name>2</name><label>Inactive (temporarily dry)</label></item><item><name>3</name><label>Destroyed / Removed</label></item><item><name>4</name><label>Seasonal Dry</label></item><item><name>5</name><label>Flooded / Inaccessible</label></item></root></instance><instance id="status_reason"><root><item><name>1</name><label>Natural drying</label></item><item><name>2</name><label>Drainage / Filled</label></item><item><name>3</name><label>Construction / Development</label></item><item><name>4</name><label>Agricultural activity</label></item><item><name>5</name><label>Flooding</label></item><item><name>6</name><label>Other</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_habitat/village" type="string" required="true()"/><bind nodeset="/data/sec1_habitat/habitat" type="string" required="true()"/><bind nodeset="/data/sec1_habitat/node_code" type="string" calculate="instance('habitats')/root/item[name= /data/sec1_habitat/habitat ]/node_code"/><bind nodeset="/data/sec1_habitat/habitat_id" type="string" calculate="instance('habitats')/root/item[name= /data/sec1_habitat/habitat ]/habitat_id"/><bind nodeset="/data/sec1_habitat/previous_status" type="string" calculate="instance('habitats')/root/item[name= /data/sec1_habitat/habitat ]/status"/><bind nodeset="/data/sec1_habitat/habitat_note" readonly="true()" type="string" relevant=" /data/sec1_habitat/habitat  != ''"/><bind nodeset="/data/sec1_update/update_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future" entities:saveto="last_update_date"/><setvalue ref="/data/sec1_update/update_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_update/collector_id" type="string" required="true()"/><bind nodeset="/data/sec2_status/q01_status" type="string" required="true()"/><bind nodeset="/data/sec2_status/q02_reason" type="string" required="true()" relevant=" /data/sec2_status/q01_status  != '1'" entities:saveto="status_reason"/><bind nodeset="/data/sec2_status/q02_reason_other" type="string" required="true()" relevant=" /data/sec2_status/q02_reason ='6'"/><bind nodeset="/data/sec2_status/q03_notes" type="string"/><bind nodeset="/data/full_name_signature" type="string" required="true()"/><bind nodeset="/data/status" type="string" calculate="if( /data/sec2_status/q01_status ='1', 'active', if( /data/sec2_status/q01_status ='2', 'inactive', if( /data/sec2_status/q01_status ='3', 'destroyed', if( /data/sec2_status/q01_status ='4', 'seasonal_dry', if( /data/sec2_status/q01_status ='5', 'flooded', '')))))" entities:saveto="status"/><bind nodeset="/data/meta/entity/@update" calculate="true()" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@baseVersion" calculate="instance('habitats')/root/item[name= /data/sec1_habitat/habitat ]/__version" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@trunkVersion" calculate="instance('habitats')/root/item[name= /data/sec1_habitat/habitat ]/__trunkVersion" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@branchId" calculate="instance('habitats')/root/item[name= /data/sec1_habitat/habitat ]/__branchId" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@id" readonly="true()" type="string" calculate=" /data/sec1_habitat/habitat "/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec1_habitat/habitat_id , &quot; - &quot;,  /data/sec1_update/update_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># HAB-UPD: Habitat Status Update</label></input><group appearance="field-list" ref="/data/sec1_habitat"><label>Section 1A: Habitat (from HAB-REG)</label><input ref="/data/sec1_habitat/village"><label>Site / Village ID</label><hint>Type it as on HAB-REG; the habitat list is filtered by it.</hint></input><select1 ref="/data/sec1_habitat/habitat" appearance="search"><label>Habitat ID</label><itemset nodeset="instance('habitats')/root/item[village= /data/sec1_habitat/village ]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_habitat/habitat_note"><label> Node: <output value=" /data/sec1_habitat/node_code "/> | Habitat: <output value=" /data/sec1_habitat/habitat_id "/> | Previous status: <output value=" /data/sec1_habitat/previous_status "/> </label></input></group><group appearance="field-list" ref="/data/sec1_update"><label>Section 1B: Status update</label><input ref="/data/sec1_update/update_date"><label>Update Date</label></input><input ref="/data/sec1_update/collector_id"><label>Collector / team ID</label></input></group><group appearance="field-list" ref="/data/sec2_status"><label>Section 2: Status update</label><select1 ref="/data/sec2_status/q01_status"><label>Q01. New status</label><itemset nodeset="instance('habitat_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_status/q02_reason"><label>Q02. Reason for change</label><itemset nodeset="instance('status_reason')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_status/q02_reason_other"><label>Q02. Specify other reason</label></input><input ref="/data/sec2_status/q03_notes" appearance="multiline"><label>Q03. Additional notes</label></input></group><input ref="/data/full_name_signature"><label>Full name (as signature)</label></input></h:body></h:html>