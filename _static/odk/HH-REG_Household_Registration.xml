?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select ref="/data/aquatic_habitat_info/aquatic_habitat_type"><label>Type of aquatic habitat</label><hint>Select all that apply</hint><itemset nodeset="instance('habitat_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/aquatic_habitat_info/aquatic_habitat_other"><label>Specify other habitat type</label></input><input ref="/data/aquatic_habitat_info/aquatic_habitat_distance"><label>Distance to nearest habitat (m)</label></input></group><group appearance="field-list" ref="/data/sleep_behavior"><label>Sleep Behavior</label><input ref="/data/sleep_behavior/sleep_time"><label>At what time do you usually sleep?</label></input><input ref="/data/sleep_behavior/wake_time"><label>At what time do you usually wake up?</label></input></group><input ref="/data/num_rooms"><label>Number of sleeping rooms</label></input><group ref="/data/room_details"><label>Room Details</label><repeat nodeset="/data/room_details" jr:count=" /data/num_rooms "><group appearance="field-list" ref="/data/room_details/room_info"><label> Room <output value=" ../room_number "/> </label><input ref="/data/room_details/room_info/room_code"><label>Room code/name</label><hint>e.g., Room 1, Bedroom</hint></input><select1 ref="/data/room_details/room_info/trap_room"><label>Is the trap placed in this room?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/room_details/room_info/room_m_under5"><label>Males under 5 years</label></input><input ref="/data/room_details/room_info/room_m_5_15"><label>Males 5-15 years</label></input><input ref="/data/room_details/room_info/room_m_over15"><label>Males above 15 years</label></input><input ref="/data/room_details/room_info/room_f_under5"><label>Females under 5 years</label></input><input ref="/data/room_details/room_info/room_f_5_15"><label>Females 5-15 years</label></input><input ref="/data/room_details/room_info/room_f_over15"><label>Females above 15 years</label></input><input ref="/data/room_details/room_info/room_total_note"><label> Total sleepers in this room: <output value=" ../room_total "/> </label></input></group></repeat></group><input ref="/data/room_details_trap_warning"><label>**Check the room entries:** more than one room is marked as the trap room.</label></input><input ref="/data/room_sleepers_check"><label> **Warning:** Sleepers in the rooms (<output value=" /data/room_sleepers "/>) do not match total occupants (<output value=" /data/members_info/hh_occupants "/>). Please verify. </label></input><input ref="/data/notes" appearance="multiline"><label>Additional comments</label></input><group appearance="field-list" ref="/data/signature_info"><label>Signature</label><input ref="/data/signature_info/full_name_signature"><label>Full name (as signature)</label><hint>Type your full name</hint></input></group></h:body></h:html>