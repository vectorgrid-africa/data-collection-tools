/members_info/hh_f_5_15"><label>Females 5-15 years</label></input><input ref="/data/members_info/hh_f_over15"><label>Females above 15 years</label></input><input ref="/data/members_info/demographic_validation"><label> **Warning:** Sum of age/sex breakdown (<output value=" /data/members_info/demographic_sum "/>) does not match total occupants (<output value=" /data/members_info/hh_occupants "/>). Please verify counts. </label></input></group><group ref="/data/structure_info"><label>House Structure</label><select1 ref="/data/structure_info/house_type"><label>House type</label><itemset nodeset="instance('house_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/structure_info/house_type_other"><label>Specify other house type</label></input><input ref="/data/structure_info/total_rooms"><label>Total rooms in house</label><hint>Count all rooms, including sleeping rooms</hint></input><select1 ref="/data/structure_info/eave_type"><label>Eave status</label><itemset nodeset="instance('eave_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/structure_info/eave_type_other"><label>Specify other eave type</label></input><select1 ref="/data/structure_info/roof_type"><label>Roof material</label><itemset nodeset="instance('roof_material')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/structure_info/roof_type_other"><label>Specify other roof type</label></input><select1 ref="/data/structure_info/has_ceiling"><label>Does house have ceiling?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/structure_info/wall_material"><label>Wall material</label><itemset nodeset="instance('wall_material')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/structure_info/wall_material_other"><label>Specify other wall material</label></input><select1 ref="/data/structure_info/wall_interior"><label>Interior wall surface</label><itemset nodeset="instance('wall_surface')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/structure_info/floor_type"><label>Floor type</label><itemset nodeset="instance('floor_material')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/structure_info/floor_type_other"><label>Specify other floor type</label></input></group><group ref="/data/openings_info"><label>Windows and Doors</label><input ref="/data/openings_info/num_windows"><label>Total number of windows</label></input><select1 ref="/data/openings_info/window_status"><label>Window status</label><itemset nodeset="instance('window_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/openings_info/num_doors"><label>Number of entry doors</label></input><select1 ref="/data/openings_info/door_status"><label>Door status</label><itemset nodeset="instance('door_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/bed_nets_info"><label>Bed Nets</label><input ref="/data/bed_nets_info/bed_nets"><label>Total bed nets owned</label><hint>Functional nets owned by the household</hint></input><input ref="/data/bed_nets_info/num_treated_nets"><label>How many are treated bed nets?</label><hint>ITN / LLIN</hint></input><input ref="/data/bed_nets_info/num_untreated_nets"><label>How many are untreated bed nets?</label></input><input ref="/data/bed_nets_info/num_unidentified_nets"><label>How many are unidentified bed nets?</label></input></group><group ref="/data/other_info"><label>Other Features</label><select1 ref="/data/other_info/latrine_inside"><label>Is latrine inside house?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/other_info/latrine_distance"><label>Distance to latrine (metres)</label></inpu