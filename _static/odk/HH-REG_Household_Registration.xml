quired="true()" entities:saveto="geometry"/><bind nodeset="/data/location_info/entity_label" type="string" calculate="concat( /data/basic_info/household_id , &quot; - &quot;,  /data/location_info/ward , &quot;, &quot;,  /data/location_info/village )"/><bind nodeset="/data/members_info/hh_occupants" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 50" jr:constraintMsg="Enter 1-50" entities:saveto="total_occupants"/><bind nodeset="/data/members_info/age_note" readonly="true()" type="string"/><bind nodeset="/data/members_info/hh_m_under5" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/members_info/hh_m_5_15" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/members_info/hh_m_over15" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/members_info/hh_f_under5" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/members_info/hh_f_5_15" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/members_info/hh_f_over15" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/members_info/demographic_sum" type="string" calculate="coalesce( /data/members_info/hh_m_under5 ,0) + coalesce( /data/members_info/hh_m_5_15 ,0) + coalesce( /data/members_info/hh_m_over15 ,0) + coalesce( /data/members_info/hh_f_under5 ,0) + coalesce( /data/members_info/hh_f_5_15 ,0) + coalesce( /data/members_info/hh_f_over15 ,0)"/><bind nodeset="/data/members_info/demographic_validation" readonly="true()" type="string" relevant=" /data/members_info/demographic_sum  !=  /data/members_info/hh_occupants "/><bind nodeset="/data/structure_info/house_type" type="string" required="true()"/><bind nodeset="/data/structure_info/house_type_other" type="string" required="true()" relevant=" /data/structure_info/house_type ='99'"/><bind nodeset="/data/structure_info/total_rooms" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 50"/><bind nodeset="/data/structure_info/eave_type" type="string" required="true()"/><bind nodeset="/data/structure_info/eave_type_other" type=