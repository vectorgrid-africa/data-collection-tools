nets " jr:constraintMsg="Treated + untreated + unidentified must equal the total" relevant=" /data/bed_nets_info/bed_nets  &gt; 0"/><bind nodeset="/data/other_info/latrine_inside" type="string" required="true()"/><bind nodeset="/data/other_info/latrine_distance" type="decimal" required="true()" constraint=". &gt;= 0" relevant=" /data/other_info/latrine_inside ='0'"/><bind nodeset="/data/other_info/has_animal_shed" type="string" required="true()"/><bind nodeset="/data/other_info/animal_shed_distance" type="decimal" required="true()" constraint=". &gt;= 0" relevant=" /data/other_info/has_animal_shed ='1'"/><bind nodeset="/data/other_info/chicken_inside" type="string" required="true()"/><bind nodeset="/data/other_info/livestock_near" type="string" required="true()"/><bind nodeset="/data/other_info/livestock_types" type="string" required="true()" relevant=" /data/other_info/livestock_near ='1'"/><bind nodeset="/data/other_info/livestock_other" type="string" required="true()" relevant="selected( /data/other_info/livestock_types , 'other')"/><bind nodeset="/data/other_info/has_interventions" type="string" required="true()"/><bind nodeset="/data/other_info/interventions" type="string" required="true()" relevant=" /data/other_info/has_interventions ='1'"/><bind nodeset="/data/other_info/interventions_other" type="string" required="true()" relevant="selected( /data/other_info/interventions , 'other')"/><bind nodeset="/data/other_info/land_use" type="string" required="true()"/><bind nodeset="/data/other_info/land_use_other" type="string" required="true()" relevant=" /data/other_info/land_use ='99'"/><bind nodeset="/data/aquatic_habitat_info/has_aquatic_habitat" type="string" required="true()"/><bind nodeset="/data/aquatic_habitat_info/aquatic_habitat_type" type="string" required="true()" relevant=" /data/aquatic_habitat_info/has_aquatic_habitat ='1'"/><bind nodeset="/data/aquatic_habitat_info/aquatic_habitat_other" type="string" required="true()" relevant="selected( /data/aquatic_habitat_info/aquatic_habitat_type , '22')"/><bind nodeset="/data/aquatic_habitat_info/aquatic_habitat_distance" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="Enter 0-100 metres" relevant=" /data/aquatic_habitat_info/has_aquatic_habitat ='1'"/><bind nodeset="/data/sleep_behavior/sleep_time" type="time" required="true()"/><bind nodeset="/data/sleep_behavior/wake_time" type="time" required="true()"/><bind nodeset="/data/num_rooms" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 30 and ( /data/structure_info/total_rooms  = '' or . &lt;=  /data/structure_info/total_rooms )" jr:constraintMsg="Enter 1-30, not more than the total rooms in the house"/><bind nodeset="/data/room_details/room_number" type="string" calculate="position(..)"/><bind nodeset="/data/room_details/room_info/room_code" type="string" required="true()"/><bind nodeset="/data/room_details/room_info/trap_room" type="string" required="true()"/><bind nodeset="/data/room_details/room_info/room_m_under5" type="int" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/room_details/room_info/room_m_5_15" type="int" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/room_details/room_info/room_m_over15" type="int" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/room_details/room_info/room_f_under5" type="int" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/room_details/room_info/room_f_5_15" type="int" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/room_details/room_info/room_f_over15" type="int" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/room_details/room_info/room_total" type="string" calculate="coalesce( ../room_m_under5 ,0) + coalesce( ../room_m_5_15 ,0) + coalesce( ../room_m_over15 ,0) + coalesce( ../room_f_under5 ,0) + coalesce( ../room_f_5_15 ,0) + coalesce( ../room_f_over15 ,0)"/><bind nodeset="/data/room_details/room_info/room_total_note" readonly="true()" type="string"/><bind nodeset="/data/room_details_trap_rooms" type="string" calculate="count( /data/room_details/room_info/trap_room [. = '1'])"/><bind nodeset="/data/room_details_trap_warning" readonly="true()" type="string" relevant=" /data/room_details_trap_rooms  &gt; 1"/><bind nodeset="/data/room_sleepers" type="string" calculate="sum( /data/room_details/room_info/room_total )"/><bind nodeset="/data/room_sleepers_check" readonly="true()" type="string" relevant=" /data/room_sleepers  !=  /data/members_info/hh_occupants "/><bind nodeset="/data/notes" type="string"/><bind nodeset="/data/signature_info/full_name_signature" type="string" required="true()"/><bind nodeset="/data/status" type="string" calculate="&quot;active&quot;" entities:saveto="status"/><bind nodeset="/data/meta/entity/@create" calculate="true()" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@id" readonly="true()" type="string"/><setvalue ref="/data/meta/entity/@id" event="odk-instance-first-load" value="uuid()"/><bind nodeset="/data/meta/entity/label" calculate=" /data/location_info/entity_label " readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/basic_info/household_id , &quot; - &quot;,  /data/basic_info/registration_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># HH-REG: Household Registration</label></input><group appearance="field-list" ref="/data/basic_info"><label>Basic Information</label><input ref="/data/basic_info/node_code"><label>Node Code</label></input><input ref="/data/basic_info/household_id"><label>Household ID</label></input><input ref="/data/basic_info/household_head"><label>Household head name</label></input><select1 ref="/data/basic_info/household_type"><label>Household type</label><itemset nodeset="instance('household_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1