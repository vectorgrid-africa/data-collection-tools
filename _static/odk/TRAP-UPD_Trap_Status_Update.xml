<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:entities="http://www.opendatakit.org/xforms/entities"><h:head><h:title>TRAP-UPD: Trap Status Update</h:title><model odk:xforms-version="1.0.0" entities:entities-version="2024.1.0"><instance><data id="vg_trap_upd" version="2026112015"><start/><end/><today/><deviceid/><username/><form_header/><sec1_trap><village/><trap/><node_code/><trap_id/><previous_status/><trap_note/></sec1_trap><sec1_update><update_date/><collector_id/></sec1_update><sec2_status><new_status/><status_reason/><notes/></sec2_status><full_name_signature/><status/><meta><entity dataset="traps" update="1" baseVersion="" trunkVersion="" branchId="" id=""/><instanceID/><instanceName/></meta></data></instance><instance id="traps" src="jr://file-csv/traps.csv"/><instance id="trap_status"><root><item><name>1</name><label>Active</label></item><item><name>2</name><label>Malfunctioned</label></item><item><name>3</name><label>Retired</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_trap/village" type="string" required="true()"/><bind nodeset="/data/sec1_trap/trap" type="string" required="true()"/><bind nodeset="/data/sec1_trap/node_code" type="string" calculate="inst