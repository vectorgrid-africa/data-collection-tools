ta/sec1_trap/trap "/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec1_trap/trap_id , &quot; - &quot;,  /data/sec1_update/update_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># TRAP-UPD: Trap Status Update</label></input><group appearance="field-list" ref="/data/sec1_trap"><label>Section 1A: Study node &amp; site links</label><input ref="/data/sec1_trap/village"><label>Village ID</label><hint>Type it as on TRAP-REG; the trap list is filtered by it.</hint></input><select1 ref="/data/sec1_trap/trap" appearance="search"><label>Trap ID (from TRAP-REG)</label><itemset nodeset="instance('traps')/root/item[village= /data/sec1_trap/village ]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_trap/trap_note"><label> Node: <output value=" /data/sec1_trap/node_code "/> | Trap: <output value=" /data/sec1_trap/trap_id "/> | Current status: <output value=" /data/sec1_trap/previous_status "/> </label></input></group><group appearance="field-list" ref="/data/sec1_update"><label>Section 1B: Status update</label><input ref="/data/sec1_update/update_date"><label>Date of Update</label></input><input ref="/data/sec1_update/collector_id"><label>Collector / team ID</label></input></group><group appearance="field-list" ref="/data/sec2_status"><label>Section 2: Trap status update</label><select1 ref="/data/sec2_status/new_status"><label>New Status</label><itemset nodeset="instance('trap_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_status/status_reason"><label>Reason for Status Change</label><hint>e.g. Battery dead</hint></input><input ref="/data/sec2_status/notes"><label>Additional Notes</label><hint>e.g. Battery replaced on site</hint></input></group><input ref="/data/full_name_signature"><label>Full name (as signature)</label></input></h:body></h:html>