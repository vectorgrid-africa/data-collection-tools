/></sec4_updates><additional_notes/><status/><meta><entity dataset="households" update="1" baseVersion="" trunkVersion="" branchId="" id=""/><instanceID/><instanceName/></meta></data></instance><instance id="households" src="jr://file-csv/households.csv"/><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="surveillance_type"><root><item><name>1</name><label>Routine monthly</label></item><item><name>2</name><label>Biannual</label></item></root></instance><instance id="household_status"><root><item><name>1</name><label>Active</label></item><item><name>2</name><label>Withdrew / refused to continue</label></item><item><name>3</name><label>Relocated / Moved</label></item><item><name>5</name><label>Temporarily inactive</label></item></root></instance><instance id="structural_change"><root><item><name>1</name><label>Yes (structural modifications made)</label></item><item><name>0</name><label>No changes (structure intact)</label></item></root></instance><instance id="house_type_change"><root><item><name>0</name><label>Unchanged</label></item><item><name>1</name><label>Traditional</label></item><item><name>2</name><label>Modern</label></item><item><name>99</name><label>Other</label></item></root></instance><instance id="wall_material"><root><item><name>1</name><label>Mud</label></item><item><name>2</name><label>Brick</label></item><item><name>3</name><label>Cement blocks</label></item><item><name>4</name><label>Thatch</label></item><item><name>99</name><label>Other</label></item></root></instance><instance id="roof_material"><root><item><name>1</name><label>Grass / Thatch</label></item><item><name>2</name><label>Metal / Iron sheets</label></item><item><name>3</name><label>Tiles</label></item><item><name>4</name><label>Concrete slab</label></item><item><name>99</name><label>Other</label></item></root></instance><instance id="eave_change"><root><item><name>0</name><label>No change</label></item><item><name>1</name><label>Open</label></item><item><name>2</name><label>Partly screened/blocked</label></item><item><name>3</name><label>Fully screened</label></item><item><name>4</name><label>Fully blocked</label></item><item><name>99</name><label>Other</label></item></root></instance><instance id="ceiling_change"><root><item><name>1</name><label>Newly installed ceiling</label></item><item><name>2</name><label>Removed / collapsed ceiling</label></item><item><name>0</name><label>No change in ceiling</label></item></root></instance><instance id="screen_change"><root><item><name>1</name><label>Screens newly installed</label></item><item><name>2</name><label>Screens damaged / removed</label></item><item><name>0</name><label>No change in screens</label></item></root></instance><instance id="new_nets"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="enclosure_change"><root><item><name>1</name><label>Newly constructed</label></item><item><name>2</name><label>Removed / dismantled</label></item><item><name>0</name><label>Unchanged</label></item></root></instance><instance id="livestock"><root><item><name>cattle</name><label>Cattle</label></item><item><name>goats</name><label>Goats</label></item><item><name>chickens</name><label>Chickens</label></item><item><name>pigs</name><label>Pigs</label></item><item><name>other</name><label>Other</label></item></root></instance><instance id="new_breeding"><root><item><name>1</name><label>Yes (new water body observed &lt;=100m)</label></item><item><name>0</name><label>None observed</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_household/village" type="string" required="true()"/><bind nodeset="/data/sec1_household/household" type="string" required="true()"/><bind nodeset="/data/sec1_household/node_code" type="string" calculate="instance('households')/root/item[name= /data/sec1_household/household ]/node_code"/><bind nodeset="/data/sec1_household/household_id" type="string" calculate="instance('households')/root/item[name= /data/sec1_household/household ]/household_id"/><bind nodeset="/data/sec1_household/previous_status" type="string" calculate="instance('households')/root/item[name= /data/sec1_household/household ]/status"/><bind nodeset="/data/sec1_household/household_note" readonly="true()" type="string" relevant=" /data/sec1_household/household  != ''"/><bind nodeset="/data/sec1_visit/update_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future" entities:saveto="last_update_date"/><setvalue ref="/data/sec1_visit/update_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_visit/surveillance_type" type="string" required="true()"/><bind nodeset="/data/sec1_visit/collector_id" type="string" required="true()"/><bind nodeset="/data/sec2_status/q01_status" type="string" required="true()"/><bind nodeset="/data/sec2_status/q02_reason" type="string" required="true()" relevant=" /data/sec2_status/q01_status  != '1'" entities:saveto="status_reason"/><bind nodeset="/data/sec2_status/q03_structural" type="string" required="true()" relevant=" /data/sec2_status/q01_status ='1'"/><bind nodeset="/data/sec3_modifications" relevant=" /data/sec2_status/q01_status ='1' and  /data/sec2_status/q03_structural ='1'"/><bind nodeset="/data/sec3_modifications/q04_house_type" type="string" required="true()"/><bind