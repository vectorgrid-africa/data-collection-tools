dates/q12_total_sleeping" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 50"/><bind nodeset="/data/sec4_updates/q12_males" type="int" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/sec4_updates/q12_females" type="int" required="true()" constraint=". &gt;= 0 and  /data/sec4_updates/q12_males  + . =  /data/sec4_updates/q12_total_sleeping " jr:constraintMsg="Males + females must equal the total"/><bind nodeset="/data/sec4_updates/q13_rooms_changed" type="string" required="true()"/><bind nodeset="/data/sec4_updates/q13_num_rooms" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 30" relevant=" /data/sec4_updates/q13_rooms_changed ='1'"/><bind nodeset="/data/sec4_updates/q13_rooms" relevant=" /data/sec4_updates/q13_rooms_changed ='1'"/><bind nodeset="/data/sec4_updates/q13_rooms/room_number" type="string" calculate="position(..)"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_id" type="string" required="true()"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/trap_room" type="string" required="true()"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_m_under5" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_m_5_15" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_m_over15" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_f_under5" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_f_5_15" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_f_over15" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 30"/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_total" type="string" calculate=" ../room_m_under5  +  ../room_m_5_15  +  ../room_m_over15  +  ../room_f_under5  +  ../room_f_5_15  +  ../room_f_over15 "/><bind nodeset="/data/sec4_updates/q13_rooms/room_info/room_total_note" readonly="true()" type="string"/><bind nodeset="/data/sec4_updates/q13_rooms_trap_rooms" type="string" calculate="count( /data/sec4_updates/q13_rooms/room_info/trap_room [. = '1'])"/><bind nodeset="/data/sec4_updates/q13_rooms_trap_warning" readonly="true()" type="string" relevant=" /data/sec4_updates/q13_rooms_trap_rooms  &gt; 1"/><bind nodeset="/data/sec4_updates/q14_new_nets" type="string" required="true()"/><bind nodeset="/data/sec4_updates/q14_num_new_nets" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 50" relevant=" /data/sec4_updates/q14_new_nets ='1'"/><bind nodeset="/data/sec4_updates/q15_interventions" type="string" required="true()"/><bind nodeset="/data/sec4_updates/q15_interventions_desc" type="string" required="true()" relevant=" /data/sec4_updates/q15_interventions ='1'"/><bind nodeset="/data/sec4_updates/q16_enclosure" type="string" required="true()"/><bind nodeset="/data/sec4_updates/q17_livestock_changed" type="string" required="true()"/><bind nodeset="/data/sec4_updates/q17_livestock_present" type="string" required="true()" relevant=" /data/sec4_updates/q17_livestock_changed ='1'"/><bind nodeset="/data/sec4_updates/q17a_livestock_types" type="string" required="true()" relevant=" /data/sec4_updates/q17_livestock_changed ='1' and  /data/sec4_updates/q17_livestock_present ='1'"/><bind nodeset="/data/sec4_updates/q17a_livestock_other" type="string" required="true()" relevant="selected( /data/sec4_updates/q17a_livestock_types , 'other')"/><bind nodeset="/data/sec4_updates/q18_new_breeding" type="string" required="true()"/><bind nodeset="/data/additional_notes" type="string"/><bind nodeset="/data/status" type="string" calculate="if( /data/sec2_status/q01_status ='1', 'active', if( /data/sec2_status/q01_status ='2', 'withdrew', if( /data/sec2_status/q01_status ='3', 'relocated', 'inactive')))" entities:saveto="status"/><bind nodeset="/data/meta/entity/@update" calculate="true()" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@baseVersion" calculate="instance('households')/root/item[name= /data/sec1_household/household ]/__version" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@trunkVersion" calculate="instance('households')/root/item[name= /data/sec1_household/household ]/__trunkVersion" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@branchId" calculate="instance('households')/root/item[name= /data/sec1_household/household ]/__branchId" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@id" readonly="true()" type="string" calculate=" /data/sec1_household/household "/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec1_household/household_id , &quot; - &quot;,  /data/sec1_visit/update_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># HH-UPD: Household Status Update</label></input><group appearance="field-list" ref="/data/sec1_household"><label>Section 1A: Study node &amp; site links</label><input ref="/data/sec1_household/village"><label>Village ID</label><hint>Type it as on HH-REG; the household list is filtered by it.</hint></input><select1 ref="/data/sec1_household/household" appearance="search"><label>Household ID</label><itemset nodeset="instance('households')/root/item[village= /data/sec1_household/village ]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_household/household_note"><label> Node: <output value=" /data/sec1_household/node_code "/> | Household: <output value=" /data/sec1_household/household_id "/> | Current status: <output value=" /data/sec1_household/previous_status "/> </label></input></group><group appearance="field-list" ref="/data/sec1_visit"><label>Section 1B: Status update &amp; visit details</label><input ref="/data/sec1_visit/update_date"><label>Date of Status Update</label></input><select1 ref="/data/sec1_visit/surveillance_type"><label>Surveillance type</label><itemset nodeset="instance('surveillance_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_visit/collector_id"><label>Collector / team ID</label></input></group><group ref="/data/sec2_status"><label>Section 2: Household status</label><select1 ref="/data/sec2_status/q01_status"><label>Q01. Household operational status</label><itemset nodeset="instance('household_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_status/q02_reason"><label>Q02. Reason for status change</label><hint>Field reason if withdrew, relocated or inactive</hint></input><select1 ref="/data/sec2_status/q03_structural"><label>Q03. Structural changes to dwelling</label><itemset nodeset="instance('structural_change')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/sec3_modifications"><label>Section 3: House modifications since last visit</label><select1 ref="/data/sec3_modifications/q04_house_type"><label>Q04. House type since last visit</label><itemset nodeset="instance('house_type_change')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_modifications/q04_house_type_other"><label>Q04. Specify other house type</label></input><select1 ref="/data/sec3_modifications/q05_wall_changed"><label>Q05. Exterior wall material altered?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_modifications/q05_wall_material"><label>Q05. New wall material</label><itemset nodeset="instance('wall_material')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_modifications/q05_wall_material_other"><label>Q05. Specify other wall material</label></input><select1 ref="/data/sec3_modifications/q06_roof_changed"><label>Q06. Roof structure / covering replaced?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_modifications/q06_roof_material"><label>Q06. New roof material</label><itemset nodeset="instance('roof_material')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_modifications/q06_roof_material_other"><label>Q06. Specify other roof material</label></input><select1 ref="/data/sec3_modifications/q07_eave_status"><label>Q07. Eave status altered?</label><itemset nodeset="instance('eave_change')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_modifications/q07_eave_status_other"><label>Q07. Specify other eave status</label></input><select1 ref="/data/sec3_modifications/q08_ceiling"><label>Q08. Ceiling status beneath roof altered?</label><itemset nodeset="instance('ceiling_change')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_modifications/q09_window_screens"><label>Q09. Window screening condition altered?</label><itemset nodeset="instance('screen_change')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_modifications/q10_new_rooms"><label>Q10. Additional sleeping rooms built?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_modifications/q11_total_rooms"><label>Q11. All rooms (current total)</label><hint>If either count changed, record both current totals, including decreases.</hint></input><input ref="/data/sec3_modifications/q11_sleeping_rooms"><label>Q11. Sleeping rooms (current total)</label><hint>If either count changed, record both current totals, including decreases.</hint></input></group><grou