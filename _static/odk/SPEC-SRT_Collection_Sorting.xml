h_details/an_tube_label" type="string" calculate="concat( /data/collection_id , &quot;-&quot;, substring-after( ../../../an_species , &quot;_&quot;), &quot;-&quot;,  ../an_sex , if( ../an_abd !=&quot;&quot;, concat(&quot;-&quot;,  ../an_abd ), &quot;&quot;), &quot;-&quot;,  ../../an_batch_num )"/><bind nodeset="/data/an_repeat/an_batches/an_batch_details/an_label_display" readonly="true()" type="string"/><bind nodeset="/data/an_repeat/an_batches/an_batch_details/an_batch_count" type="int" required="true()" constraint=". &gt;= 1" jr:constraintMsg="At least 1"/><bind nodeset="/data/an_repeat/an_batches/an_batch_details/an_sample_type" type="string" required="true()"/><bind nodeset="/data/an_repeat/an_batches/an_batch_details/an_storage_box" type="string" required="true()"/><bind nodeset="/data/an_repeat/an_batches/an_batch_details/an_box_position" type="string" required="true()"/><bind nodeset="/data/an_repeat/an_batches/an_batch_details/an_batch_notes" type="string"/><bind nodeset="/data/an_repeat/an_tubed" type="string" calculate="sum( ../an_batches/an_batch_details/an_batch_count )"/><bind nodeset="/data/an_repeat/an_discard_count" type="string" calculate="if( ../an_counts_packing/an_discarded !=&quot;&quot;, ../an_counts_packing/an_discarded ,0)"/><bind nodeset="/data/an_repeat/an_unaccounted" type="string" calculate=" ../an_counts_packing/an_total  -  ../an_tubed  -  ../an_discard_count "/><bind nodeset="/data/an_repeat/an_mismatch" type="string" calculate="if( ../an_unaccounted  != 0, 1, 0)"/><bind nodeset="/data/an_repeat/an_mismatch_warning" readonly="true()" type="string" relevant=" ../an_mismatch  = 1"/><bind nodeset="/data/an_repeat/an_line" type="string" calculate="concat( ../an_name , &quot; = &quot;,  ../an_counts_packing/an_total , &quot; (M &quot;,  ../an_counts_packing/an_male_count , &quot; / F &quot;,  ../an_counts_packing/an_female_count , &quot;)&quot;)"/><bind nodeset="/data/cul_repeat" relevant=" /data/collection_outcome/mosquitoes_caught ='1'"/><bind nodeset="/data/cul_repeat/cul_species" type="string" required="true()"/><bind nodeset="/data/cul_repeat/cul_species_other" type="string" required="true()" relevant=" ../cul_species ='other'"/><bind nodeset="/data/cul_repeat/cul_name" type="string" calculate="if( ../cul_species ='other',  ../cul_species_other , jr:choice-name( ../cul_species , ' ../cul_species '))"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_counts_header" readonly="true()" type="string"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_male_total" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_female_total" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_female_count" type="string" calculate="if( ../cul_female_total !=&quot;&quot;, ../cul_female_total ,0)"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_male_count" type="string" calculate="if( ../cul_male_total !=&quot;&quot;, ../cul_male_total ,0)"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_total" type="string" calculate=" ../cul_male_count  +  ../cul_female_count "/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_total_note" readonly="true()" type="string"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_packing_header" readonly="true()" type="string" relevant=" ../cul_total  &gt; 0"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_num_batches" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="Enter 0-100 (0 if all discarded)" relevant=" ../cul_total  &gt; 0"/><bind nodeset="/data/cul_repeat/cul_counts_packing/cul_discarded" type="int" constraint=". &gt;= 0" relevant=" ../cul_total  &gt; 0"/><bind nodeset="/data/cul_repeat/cul_batches" relevant=" ../cul_counts_packing/cul_total  &gt; 0 and  ../cul_counts_packing/cul_num_batches  &gt; 0"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_num" type="string" calculate="position(..)"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_sex" type="string" required="true()"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_abd" type="string" required="true()" relevant=" ../cul_sex ='F'"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_tube_label" type="string" calculate="concat( /data/collection_id , &quot;-&quot;, substring-after( ../../../cul_species , &quot;_&quot;), &quot;-&quot;,  ../cul_sex , if( ../cul_abd !=&quot;&quot;, concat(&quot;-&quot;,  ../cul_abd ), &quot;&quot;), &quot;-&quot;,  ../../cul_batch_num )"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_label_display" readonly="true()" type="string"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_batch_count" type="int" required="true()" constraint=". &gt;= 1" jr:constraintMsg="At least 1"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_sample_type" type="string" required="true()"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_storage_box" type="string" required="true()"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_box_position" type="string" required="true()"/><bind nodeset="/data/cul_repeat/cul_batches/cul_batch_details/cul_batch_notes" type="string"/><bind nodeset="/data/cul_repeat/cul_tubed" type="string" calculate="sum( ../cul_batches/cul_batch_details/cul_batch_count )"/><bind nodeset="/data/cul_repeat/cul_discard_count" type="string" calculate="if( ../cul_counts_packing/cul_discarded !=&quot;&quot;, ../cul_counts_packing/cul_discarded ,0)"/><bind nodeset="/data/cul_repeat/cul_unaccounted" type="string" calculate=" ../cul_counts_packing/cul_total  -  ../cul_tubed  -  ../cul_discard_count "/><bind nodeset="/data/cul_repeat/cul_mismatch" type="string" calculate="if( ../cul_unaccounted  != 0, 1, 0)"/><bind nodeset="/data/cul_repeat/cul_mismatch_warning" readonly="true()" type="string" relevant=" ../cul_mismatch  = 1"/><bind nodeset="/data/cul_repeat/cul_line" type="string" calculate="concat( ../cul_name , &quot; = &quot;,  ../cul_counts_packing/cul_total , &quot; (M &quot;,  ../cul_counts_packing/cul_male_count , &quot; / F &quot;,  ../cul_counts_packing/cul_female_count , &quot;)&quot;)"/><bind nodeset="/data/bycatch_group" relevant=" /data/collection_outcome/mosquitoes_caught ='1'"/><bind nodeset="/data/bycatch_group/bycatch_note" readonly="true()" type="string"/><bind nodeset="/data/bycatch_group/bycatch_count" type="int" constraint=". &gt;= 0"/><bind nodeset="/data/summary_an_total" type="string" calculate="sum( /data/an_repeat/an_counts_packing/an_total )"/><bind nodeset="/data/sum_an_female" type="string" calculate="sum( /data/an_repeat/an_counts_packing/an_female_count )"/><bind nodeset="/data/for_dissection" type="string" required="true()" relevant=" /data/summary_an_total  &gt; 0"/><bind nodeset="/data/dissection_qty" type="int" required="true()" constraint=". &gt;= 1 and . &lt;=  /data/sum_an_female " jr:constraintMsg="Cannot exceed the Anopheles females sorted" relevant=" /data/for_dissection ='1'"/><bind nodeset="/data/sum_tubes" type="string" calculate="count( /data/an_repeat/an_batches/an_batch_num ) + count( /data/cul_repeat/cul_batches/cul_batch_num )"/><bind nodeset="/data/register_id" type="string" required="true()" relevant=" /data/sum_tubes  &gt; 0"/><bind nodeset="/data/notes" type="string"/><bind nodeset="/data/sum_an_male" type="string" calculate="sum( /data/an_repeat/an_counts_packing/an_male_count )"/><bind nodeset="/data/sum_cul_total" type="string" calculate="sum( /data/cul_repeat/cul_counts_packing/cul_total )"/><bind nodeset="/data/sum_cul_male" type="string" calculate="sum( /data/cul_repeat/cul_counts_packing/cul_male_count )"/><bind nodeset="/data/sum_cul_female" type="string" calculate="sum( /data/cul_repeat/cul_counts_packing/cul_female_count )"/><bind nodeset="/data/sum_bycatch" type="string" calculate="if( /data/bycatch_group/bycatch_count !=&quot;&quot;, /data/bycatch_group/bycatch_count ,0)"/><bind nodeset="/data/sum_mosquitoes" type="string" calculate=" /data/summary_an_total  +  /data/sum_cul_total "/><bind nodeset="/data/sum_tubed" type="string" calculate="sum( /data/an_repeat/an_tubed ) + sum( /data/cul_repeat/cul_tubed )"/><bind nodeset="/data/sum_discarded" type="string" calculate="sum( /data/an_repeat/an_discard_count ) + sum( /data/cul_repeat/cul_discard_count )"/><bind nodeset="/data/sum_mismatches" type="string" calculate="sum( /data/an_repeat/an_mismatch ) + sum( /data/cul_repeat/cul_mismatch )"/><bind nodeset="/data/an_species_list" type="string" calculate="join(&quot; | &quot;,  /data/an_repeat/an_line )"/><bind nodeset="/data/cul_species_list" type="string" calculate="join(&quot; | &quot;,  /data/cul_repeat/cul_line )"/><bind nodeset="/data/form_summary/sum_header" readonly="true()" type="string"/><bind nodeset="/data/form_summary/sum_ident_trap" readonly="true()" type="string" relevant=" /data/form_info/origin ='1'"/><bind nodeset="/data/form_summary/sum_ident_reared" readonly="true()" type="string" relevant=" /data/form_info/origin ='2'"/><bind nodeset="/data/form_summary/sum_id" readonly="true()" type="string"/><bind nodeset="/data/form_summary/sum_invalid" readonly="true()" type="string" relevant=" /data/collection_outcome/valid_catch ='0'"/><bind nodeset="/data/form_summary/sum_no_catch" readonly="true()" type="string" relevant=" /data/collection_outcome/mosquitoes_caught ='0'"/><bind nodeset="/data/form_summary/sum_sorting" readonly="true()" type="string" relevant=" /data/collection_outcome/mosquitoes_caught ='1'"/><bind nodeset="/data/form_summary/sum_an_species" readonly="true()" type="string" relevant=" /data/collection_outcome/mosquitoes_caught ='1' and count( /data/an_repeat/an_line ) &gt; 0"/><bind nodeset="/data/form_summary/sum_cul_species" readonly="true()" type="string" relevant=" /data/collection_outcome/mosquitoes_caught ='1' and count( /data/cul_repeat/cul_line ) &gt; 0"/><bind nodeset="/data/form_summary/sum_packing" readonly="true()" type="string" relevant=" /data/collection_outcome/mosquitoes_caught ='1'"/><bind nodeset="/data/form_summary/sum_check_counts" readonly="true()" type="string" relevant=" /data/sum_mismatches  &gt; 0"/><bind nodeset="/data/form_summary/sum_check_empty" readonly="true()" type="string" relevant=" /data/collection_outcome/mosquitoes_caught ='1' and  /data/sum_mosquitoes  = 0"/><bind nodeset="/data/form_summary/sum_checks_ok" readonly="true()" type="string" relevant=" /data/sum_mismatches  = 0 and not( /data/collection_outcome/mosquitoes_caught ='1' and  /data/sum_mosquitoes  = 0)"/><bind nodeset="/data/form_summary/summary_confirmed" type="string" required="true()" constraint=". = '1'" jr:constraintMsg="Go back and correct the data before submitting"/><bind nodeset="/data/form_summary/full_name_signature" type="string" required="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/collection_id , &quot; - &quot;,  /data/form_info/collection_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># SPEC-SRT: Mosquito Collection and Sorting</label></input><input ref="/data/part_a_header"><label># PART A: Collection Information</label></input><group appearance="field-list" ref="/data/form_info"><label>Form Information</label><input ref="/data/form_info/collection_date"><label>Collection date</label></input><select1 ref="/data/form_info/surveillance_type"><label>Surveillance type</label><itemset nodeset="instance('surveillance_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/form_info/collector_id"><label>Collector ID (registered staff ID)</label><hint>Your registered staff ID, not your name</hint></input><select1 ref="/data/form_info/origin"><label>Origin</label><itemset nodeset="instance('origin')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/form_info/source_vial"><label>Source vial / habitat ID</label><hint>Larval vial ID from HAB-SRV</hint></input><input ref="/data/form_info/household_site"><label>Household / site ID</label><hint>Where the larvae were collected</hint></input></group><select1 ref="/data/district" appearance="minimal autocomplete"><label>Select district</label><hint>Filter households and traps by district</hint><itemset nodeset="instance('district')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/at_household"><label>Is the trap at a household?</label><hint>No = outdoor site with no household</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><group ref="/data/household_selection"><label>Household Selection</label><select1 ref="/data/household_selection/household" appearance="search"><label>Select household</label><hint>The household where the trap is placed</hint><itemset nodeset="instance('households')/root/item[district= /data/district ]"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/trap_selection"><label>Trap Selection</label><select1 ref="/data/trap_selection/trap" appearance="search"><label>Select trap</label><hint>Select the trap being collected</hint><itemset nodeset="instance('traps')/root/item[status=&quot;active&quot; and (( /data/at_household ='1' and household_id= /data/household_selection/household ) or ( /data/at_household ='0' and district= /data/district  and household_id=&quot;&quot;))]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/trap_selection/trap_note"><label> **Trap:** <output value=" /data/trap_selection/trap_label "/> | **Node:** <output value=" /data/trap_selection/node_code "/> </label></input></group><group appearance="field-list" ref="/data/timing_info"><label>Timing</label><input ref="/data/timing_info/start_time"><label>Start (date and time)</label></input><input ref="/data/timing_info/end_time"><label>End (date and time)</label></input><select1 ref="/data/timing_info/whole_period"><label>Did the trap operate for the whole period?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/timing_info/light_at_retrieval"><label>Light at retrieval</label><itemset nodeset="instance('light_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/timing_info/bg_bag"><label>BG bag</label><hint>Enter each BG bag as its own record</hint><itemset nodeset="instance('bg_bag')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group appearance="field-list" ref="/data/collection_outcome"><label>Collection Outcome</label><select1 ref="/data/collection_outcome/valid_catch"><label>Was collection valid?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/collection_outcome/invalid_reason"><label>Reason if invalid</label></input><select1 ref="/data/collection_outcome/mosquitoes_caught"><label>Were mosquitoes caught?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><input ref="/data/part_b_header"><label># PART B: Sample Sorting</label></input><input ref="/data/sorting_date"><label>Sorting date</label></input><group ref="/data/an_repeat"><label>Anopheles species</label><repeat nodeset="/data/an_repeat"><select1 ref="/data/an_repeat/an_species" appearance="search"><label>Anopheles specie</label><itemset nodeset="instance('anopheles_species')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/an_repeat/an_species_other"><label>Specify other species</label></input><group appearance="field-list" ref="/data/an_repeat/an_counts_packing"><label> Counts &amp; Packing for <output value=" ../an_name "/> </label><input ref="/data/an