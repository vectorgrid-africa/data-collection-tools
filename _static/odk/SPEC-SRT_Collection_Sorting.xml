 and  /data/sec3_taxa/all_tubes  &gt; 0"/><bind nodeset="/data/packing" relevant=" /data/sec2_outcome/q06_valid ='1' and  /data/sec2_outcome/q07_caught ='1' and  /data/sec3_taxa/all_tubes  &gt; 0"/><bind nodeset="/data/packing/packing_number" type="string" calculate="position(..)"/><bind nodeset="/data/packing/packing_info/q10_packing_type" type="string" required="true()"/><bind nodeset="/data/packing/packing_info/q11_box_barcode" type="string" required="true()"/><bind nodeset="/data/packing/packing_info/q12_position_from" type="string" required="true()"/><bind nodeset="/data/packing/packing_info/q12_position_to" type="string" required="true()"/><bind nodeset="/data/packing/packing_info/q13_register_id" type="string" required="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec2_outcome/q05_collection_id , &quot; - &quot;,  /data/sec1_event/collection_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># SPEC-SRT: Mosquito Collection and Sorting</label></input><group appearance="field-list" ref="/data/sec1_event"><label>Section 1B: Collection trap &amp; retrieval context</label><input ref="/data/sec1_event/collection_date"><label>Collection Date</label></input><select1 ref="/data/sec1_event/surveillance_type"><label>Surveillance type</label><itemset nodeset="instance('surveillance_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_event/collector_id"><label>Collector / team ID</label></input><select1 ref="/data/sec1_event/origin"><label>Origin</label><itemset nodeset="instance('origin')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_event/source_vial"><label>Source vial / habitat ID</label><hint>Larval vial ID from HAB-SRV</hint></input></group><group appearance="field-list" ref="/data/sec1_links"><label>Section 1A: Study node &amp; site links</label><input ref="/data/sec1_links/village"><label>Village ID</label><hint>Type it as on TRAP-REG; the trap list is filtered by it.</hint></input><select1 ref="/data/sec1_links/trap" appearance="search"><label>Trap ID (from TRAP-REG)</label><itemset nodeset="instance('traps')/root/item[village= /data/sec1_links/village  and status=&quot;active&quot;]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_links/household_site"><label>Household / Site ID (only if no Trap ID)</label></input><input ref="/data/sec1_links/deployment_id"><label>Deployment ID</label><hint>One per trap-night; both BG portions use it.</hint></input></group><input ref="/data/trap_note"><label> Node: <output value=" /data/node_code "/> | Trap: <output value=" /data/trap_id "/> <output value=" /data/site_id "/> </label></input><group ref="/data/sec2_outcome"><label>Section 2: Collection outcome</label><input ref="/data/sec2_outcome/q01_start"><label>Q01. Trap or BG portion start (date and time, 24 h)</label></input><input ref="/data/sec2_outcome/q01_end"><label>Q01. Trap or BG portion end (date and time, 24 h)</label></input><select1 ref="/data/sec2_outcome/q02_bg_portion"><label>Q02. BG portion</label><hint>BG only. Use the same deployment ID for both portions.</hint><itemset nodeset="instance('bg_portion')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_outcome/q03_whole_period"><label>Q03. Operation for the whole period</label><hint>CDC or BG only. Did the trap operate throughout this interval?</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_outcome/q04_light"><label>Q04. Light at retrieval</label><hint>CDC only. What was the light status at retrieval?</hint><itemset nodeset="instance('light_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_outcome/q05_collection_id"><label>Q05. Collection Record ID</label><hint>Unique ID for this catch, reared lot or BG portion. Use on SPEC-DIS.</hint></input><select1 ref="/data/sec2_outcome/q06_valid"><label>Q06. Collection validity &amp; outcome</label><itemset nodeset="instance('validity')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_outcome/q06_invalid_reason"><label>Q06. Reason invalid</label></input><select1 ref="/data/sec2_outcome/q07_caught"><label>Q07. Mosquitoes caught</label><itemset nodeset="instance('caught')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_outcome/q07_sorting_date"><label>Q07. Sorting Date</label></input></group><group ref="/data/sec3_taxa"><label>Section 3: Taxonomy &amp; physiological counts</label><group appearance="field-list" ref="/data/sec3_taxa/gam_counts"><label>Anopheles gambiae s.l.</label><input ref="/data/sec3_taxa/gam_counts/gam_uf"><label>Females - Unfed (UF)</label></input><input ref="/data/sec3_taxa/gam_counts/gam_pf"><label>Females - Partly fed (PF)</label></input><input ref="/data/sec3_taxa/gam_counts/gam_fd"><label>Females - Fully fed (FD)</label></input><input ref="/data/sec3_taxa/gam_counts/gam_sg"><label>Females - Semi-gravid</label></input><input ref="/data/sec3_taxa/gam_counts/gam_gv"><label>Females - Gravid (GV)</label></input><input ref="/data/sec3_taxa/gam_counts/gam_males"><label>Total males</label></input><input ref="/data/sec3_taxa/gam_counts/gam_total_note"><label> Total females: <output value=" /data/sec3_taxa/gam_counts/gam_females "/> | Total males: <output value=" /data/sec3_taxa/gam_counts/gam_males "/> | **Total mosquitoes: <output value=" /data/sec3_taxa/gam_counts/gam_total "/>** </label></input><input ref="/data/sec3_taxa/gam_counts/gam_tubes"><label>Tubes packed</label></input><input ref="/data/sec3_taxa/gam_counts/gam_discarded"><label>No. discarded</label></input></group><group appearance="field-list" ref="/data/sec3_taxa/fun_counts"><label>Anopheles funestus group</label><input ref="/data/sec3_taxa/fun_counts/fun_uf"><label>Females - Unfed (UF)</label></input><input ref="/data/sec3_taxa/fun_counts/fun_pf"><label>Females - Partly fed (PF)</label></input><input ref="/data/sec3_taxa/fun_counts/fun_fd"><label>Females - Fully fed (FD)</label></input><input ref="/data/sec3_taxa/fun_counts/fun_sg"><label>Females - Semi-gravid</label></input><input ref="/data/sec3_taxa/fun_counts/fun_gv"><label>Females - Gravid (GV)</label></input><input ref="/data/sec3_taxa/fun_counts/fun_males"><label>Total males</label></input><input ref="/data/sec3_taxa/fun_counts/fun_total_note"><label> Total females: <output value=" /data/sec3_taxa/fun_counts/fun_females "/> | Total males: <output value=" /data/sec3_taxa/fun_counts/fun_males "/> | **Total mosquitoes: <output value=" /data/sec3_taxa/fun_counts/fun_total "/>** </label></input><input ref="/data/sec3_taxa/fun_counts/fun_tubes"><label>Tubes packed</label></input><input ref="/data/sec3_taxa/fun_counts/fun_discarded"><label>No. discarded</label></input></group><select1 ref="/data/sec3_taxa/has_other_taxa"><label>Any other taxa to record?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_taxa/num_other_taxa"><label>Number of other taxa</label></input><group ref="/data/sec3_taxa/other_taxa"><label>Other taxon</label><repeat nodeset="/data/sec3_taxa/other_taxa" jr:count=" /data/sec3_taxa/num_other_taxa "><group appearance="field-list" ref="/data/sec3_taxa/other_taxa/oth_counts"><label>Other taxon</label><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_taxon"><label>Taxon / identification group</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_uf"><label>Females - Unfed (UF)</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_pf"><label>Females - Partly fed (PF)</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_fd"><label>Females - Fully fed (FD)</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_sg"><label>Females - Semi-gravid</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_gv"><label>Females - Gravid (GV)</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_males"><label>Total males</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_total_note"><label> Total females: <output value=" ../oth_females "/> | Total males: <output value=" ../oth_males "/> | **Total mosquitoes: <output value=" ../oth_total "/>** </label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_tubes"><label>Tubes packed</label></input><input ref="/data/sec3_taxa/other_taxa/oth_counts/oth_discarded"><label>No. discarded</label></input></group></repeat></group><input ref="/data/sec3_taxa/sec3_totals"><label> ## Total mosquitoes sorted

