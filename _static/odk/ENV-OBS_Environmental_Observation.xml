<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>ENV-OBS: Environmental Observation</h:title><model odk:xforms-version="1.0.0"><instance><data id="vg_env_obs" version="2026112101"><start/><end/><today/><deviceid/><username/><form_header/><sec1_links><district/><household/></sec1_links><node_code/><household_id/><hh_village/><hh_ward/><household_note/><sec1_event><collection_date/><collector_id/><method/></sec1_event><sec2_weather><weather_start/><weather_start_other/><weather_end/><weather_end_other/><rainfall_24h/><rainfall_week/><wind_speed/></sec2_weather><num_loggers>2</num_loggers><loggers jr:template=""><logger_number/><logger_info><logger_serial/><logger_placement/><logger_height/><logger_start/><logger_stop/><logger_download/></logger_info></loggers><loggers><logger_number/><logger_info><logger_serial/><logger_placement/><logger_height/><logger_start/><logger_stop/><logger_download/></logger_info></loggers><loggers_failed/><sec3_microclimate><sec3_note/><t_out_group><t_out_start/><t_out_min/><t_out_max/><t_out_end/></t_out_group><t_in_group><t_in_start/><t_in_min/><t_in_max/><t_in_end/></t_in_group><rh_out_group><rh_out_start/><rh_out_min/><rh_out_max/><rh_out_end/></rh_out_group><rh_in_group><rh_in_start/><rh_in_min/><rh_in_max/><rh_in_end/></rh_in_group></sec3_microclimate><notes/><signature_info><full_name_signature/></signature_info><meta><instanceID/><instanceName/></meta></data></instance><instance id="households" src="jr://file-csv/households.csv"/><instance id="measurement_method"><root><item><name>1</name><label>Automated logger</label></item><item><name>2</name><label>Manual meter</label></item></root></instance><instance id="weather"><root><item><name>rainy</name><label>Rainy</label></item><item><name>windy</name><label>Windy</label></item><item><name>cold</name><label>Cold</label></item><item><name>warm</name><label>Warm</label></item><item><name>none</name><label>None of these (calm, dry)</label></item><item><name>other</name><label>Other</label></item></root></instance><instance id="logger_placement"><root><item><name>1</name><label>Indoor</label></item><item><name>2</name><label>Outdoor</label></item></root></instance><instance id="download_status"><root><item><name>1</name><label>Pass</label></item><item><name>0</name><label>Fail</label></item></root></instance><instance id="district"><root><item><name>kilombero</name><label>Kilombero</label></item><item><name>malinyi</name><label>Malinyi</label></item><item><name>mlimba</name><label>Mlimba</label></item><item><name>ulanga</name><label>Ulanga</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_links/district" type="string" required="true()"/><bind nodeset="/data/sec1_links/household" type="string" required="true()"/><bind nodeset="/data/node_code" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/node_code"/><bind nodeset="/data/household_id" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/household_id"/><bind nodeset="/data/hh_village" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/village"/><bind nodeset="/data/hh_ward" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/ward"/><bind nodeset="/data/household_note" readonly="true()" type="string" relevant=" /data/sec1_links/household  != ''"/><bind nodeset="/data/sec1_event/collection_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future"/><setvalue ref="/data/sec1_event/collection_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_event/collector_id" type="string" required="true()"/><bind nodeset="/data/sec1_event/method" type="string" required="true()"/><bind nodeset="/data/sec2_weather/weather_start" type="string" required="true()" constraint="not(selected(., 'none') and count-selected(.) &gt; 1)" jr:constraintMsg="&quot;None of these&quot; cannot be combined with other choices"/><bind nodeset="/data/sec2_weather/weather_start_other" type="string" required="true()" relevant="selected( /data/sec2_weather/weather_start , 'other')"/><bind nodeset="/data/sec2_weather/weather_end" type="string" required="true()" constraint="not(selected(., 'none') and count-selected(.) &gt; 1)" jr:constraintMsg="&quot;None of these&quot; cannot be combined with other choices"/><bind nodeset="/data/sec2_weather/weather_end_other" type="string" required="true()" relevant="selected( /data/sec2_weather/weather_end , 'other')"/><bind nodeset="/data/sec2_weather/rainfall_24h" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 500"/><bind nodeset="/data/sec2_weather/rainfall_week" type="decimal" required="true()" constraint=". &gt;=  /data/sec2_weather/rainfall_24h  and . &lt;= 2000" jr:constraintMsg="Last week cannot be less than the last 24 hours"/><bind nodeset="/data/sec2_weather/wind_speed" type="decimal" constraint=". &gt;= 0 and . &lt;= 60"/><bind nodeset="/data/num_loggers" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 4" relevant=" /data/sec1_event/method ='1'"/><bind nodeset="/data/loggers" relevant=" /data/sec1_event/method ='1'"/><bind nodeset="/data/loggers/logger_number" type="string" calculate="position(..)"/><bind nodeset="/data/loggers/logger_info/logger_serial" type="string" required="true()"/><bind nodeset="/data/loggers/logger_info/logger_placement" type="string" required="true()"/><bind nodeset="/data/loggers/logger_info/logger_height" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 10"/><bind nodeset="/data/loggers/logger_info/logger_start" type="time" required="true()"/><bind nodeset="/data/loggers/logger_info/logger_stop" type="time" required="true()"/><bind nodeset="/data/loggers/logger_info/logger_download" type="string" required="true()"/><bind nodeset="/data/loggers_failed" type="string" calculate="count( /data/loggers/logger_info/logger_download [. = '0'])"/><bind nodeset="/data/sec3_microclimate" relevant=" /data/sec1_event/method ='2' or  /data/loggers_failed  &gt; 0"/><bind nodeset="/data/sec3_microclimate/sec3_note" readonly="true()" type="string"/><bind nodeset="/data/sec3_microclimate/t_out_group/t_out_start" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60"/><bind nodeset="/data/sec3_microclimate/t_out_group/t_out_min" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60"/><bind nodeset="/data/sec3_microclimate/t_out_group/t_out_max" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60 and ( /data/sec3_microclimate/t_out_group/t_out_min  = '' or . &gt;=  /data/sec3_microclimate/t_out_group/t_out_min )" jr:constraintMsg="Max cannot be lower than min"/><bind nodeset="/data/sec3_microclimate/t_out_group/t_out_end" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60"/><bind nodeset="/data/sec3_microclimate/t_in_group/t_in_start" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60"/><bind nodeset="/data/sec3_microclimate/t_in_group/t_in_min" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60"/><bind nodeset="/data/sec3_microclimate/t_in_group/t_in_max" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60 and ( /data/sec3_microclimate/t_in_group/t_in_min  = '' or . &gt;=  /data/sec3_microclimate/t_in_group/t_in_min )" jr:constraintMsg="Max cannot be lower than min"/><bind nodeset="/data/sec3_microclimate/t_in_group/t_in_end" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= -10 and . &lt;= 60"/><bind nodeset="/data/sec3_microclimate/rh_out_group/rh_out_start" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_microclimate/rh_out_group/rh_out_min" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_microclimate/rh_out_group/rh_out_max" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100 and ( /data/sec3_microclimate/rh_out_group/rh_out_min  = '' or . &gt;=  /data/sec3_microclimate/rh_out_group/rh_out_min )" jr:constraintMsg="Max cannot be lower than min"/><bind nodeset="/data/sec3_microclimate/rh_out_group/rh_out_end" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_microclimate/rh_in_group/rh_in_start" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_microclimate/rh_in_group/rh_in_min" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_microclimate/rh_in_group/rh_in_max" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100 and ( /data/sec3_microclimate/rh_in_group/rh_in_min  = '' or . &gt;=  /data/sec3_microclimate/rh_in_group/rh_in_min )" jr:constraintMsg="Max cannot be lower than min"/><bind nodeset="/data/sec3_microclimate/rh_in_group/rh_in_end" type="decimal" required=" /data/sec1_event/method ='2'" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/notes" type="string"/><bind nodeset="/data/signature_info/full_name_signature" type="string" required="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/household_id , &quot; - &quot;,  /data/sec1_event/collection_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># ENV-OBS: Environmental Observation</label></input><group appearance="field-list" ref="/data/sec1_links"><label>Household Selection</label><select1 ref="/data/sec1_links/district" appearance="minimal autocomplete"><label>Select district</label><hint>Filter households by district</hint><itemset nodeset="instance('district')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec1_links/household" appearance="search"><label>Select household</label><itemset nodeset="instance('households')/root/item[district= /data/sec1_links/district  and status=&quot;active&quot;]"><value ref="name"/><label ref="label"/></itemset></select1></group><input ref="/data/household_note"><label> **Household:** <output value=" /data/household_id "/> | **Village:** <output value=" /data/hh_village "/>, <output value=" /data/hh_ward "/> | **Node:** <output value=" /data/node_code "/> </label></input><group appearance="field-list" ref="/data/sec1_event"><label>Sampling Event</label><input ref="/data/sec1_event/collection_date"><label>Collection Date</label><hint>Same date as the SPEC-SRT record</hint></input><input ref="/data/sec1_event/collector_id"><label>Collector ID (registered staff ID)</label><hint>Your registered staff ID, not your name</hint></input><select1 ref="/data/sec1_event/method"><label>Measurement Method</label><itemset nodeset="instance('measurement_method')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/sec2_weather"><label>Weather Observations</label><select ref="/data/sec2_weather/weather_start"><label>Weather at trap start</label><hint>Tick all that apply</hint><itemset nodeset="instance('weather')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/sec2_weather/weather_start_other"><label>Specify other weather</label></input><select ref="/data/sec2_weather/weather_end"><label>Weather at trap end</label><hint>Tick all that apply</hint><itemset nodeset="instance('weather')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/sec2_weather/weather_end_other"><label>Specify other weather</label></input><input ref="/data/sec2_weather/rainfall_24h"><label>Rainfall - last 24 hours (mm)</label></input><input ref="/data/sec2_weather/rainfall_week"><label>Rainfall - last week (mm)</label></input><input ref="/data/sec2_weather/wind_speed"><label>Wind speed (optional, m/s)</label><hint>Instantaneous measured wind velocity in metres per second</hint></input></group><input ref="/data/num_loggers"><label>Number of data loggers</label></input><group ref="/data/loggers"><label>Temperature &amp; Humidity Data Loggers</label><repeat nodeset="/data/loggers" jr:count=" /data/num_loggers "><group appearance="field-list" ref="/data/loggers/logger_info"><label> Logger 0<output value=" ../logger_number "/> </label><input ref="/data/loggers/logger_info/logger_serial"><label>Barcode / serial no.</label></input><select1 ref="/data/loggers/logger_info/logger_placement"><label>Placement</label><itemset nodeset="instance('logger_placement')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/loggers/logger_info/logger_height"><label>Height (m)</label></input><input ref="/data/loggers/logger_info/logger_start"><label>Start time</label></input><input ref="/data/loggers/logger_info/logger_stop"><label>Stop time</label></input><select1 ref="/data/loggers/logger_info/logger_download"><label>Download status</label><itemset nodeset="instance('download_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group></repeat></group><group ref="/data/sec3_microclimate"><label>Indoor &amp; Outdoor Temperature &amp; Humidity</label><input ref="/data/sec3_microclimate/sec3_note"><label>Required for a manual meter. If a logger failed, enter any readings you have and leave the rest blank. Trap start and end times are on SPEC-SRT.</label></input><group appearance="field-list" ref="/data/sec3_microclimate/t_out_group"><label>Temperature (°C) - Outdoor</label><input ref="/data/sec3_microclimate/t_out_group/t_out_start"><label>At trap start</label></input><input ref="/data/sec3_microclimate/t_out_group/t_out_min"><label>Overnight min (low)</label></input><input ref="/data/sec3_microclimate/t_out_group/t_out_max"><label>Overnight max (high)</label></input><input ref="/data/sec3_microclimate/t_out_group/t_out_end"><label>At trap end</label></input></group><group appearance="field-list" ref="/data/sec3_microclimate/t_in_group"><label>Temperature (°C) - Indoor</label><input ref="/data/sec3_microclimate/t_in_group/t_in_start"><label>At trap start</label></input><input ref="/data/sec3_microclimate/t_in_group/t_in_min"><label>Overnight min (low)</label></input><input ref="/data/sec3_microclimate/t_in_group/t_in_max"><label>Overnight max (high)</label></input><input ref="/data/sec3_microclimate/t_in_group/t_in_end"><label>At trap end</label></input></group><group appearance="field-list" ref="/data/sec3_microclimate/rh_out_group"><label>Relative Humidity (%) - Outdoor</label><input ref="/data/sec3_microclimate/rh_out_group/rh_out_start"><label>At trap start</label></input><input ref="/data/sec3_microclimate/rh_out_group/rh_out_min"><label>Overnight min (low)</label></input><input ref="/data/sec3_microclimate/rh_out_group/rh_out_max"><label>Overnight max (high)</label></input><input ref="/data/sec3_microclimate/rh_out_group/rh_out_end"><label>At trap end</label></input></group><group appearance="field-list" ref="/data/sec3_microclimate/rh_in_group"><label>Relative Humidity (%) - Indoor</label><input ref="/data/sec3_microclimate/rh_in_group/rh_in_start"><label>At trap start</label></input><input ref="/data/sec3_microclimate/rh_in_group/rh_in_min"><label>Overnight min (low)</label></input><input ref="/data/sec3_microclimate/rh_in_group/rh_in_max"><label>Overnight max (high)</label></input><input ref="/data/sec3_microclimate/rh_in_group/rh_in_end"><label>At trap end</label></input></group></group><input ref="/data/notes" appearance="multiline"><label>Additional environmental notes</label><hint>Field observations (e.g. sudden weather change, spraying or smoke)</hint></input><group appearance="field-list" ref="/data/signature_info"><label>Signature</label><input ref="/data/signature_info/full_name_signature"><label>Full name (as signature)</label><hint>Type your full name</hint></input></group></h:body></h:html>