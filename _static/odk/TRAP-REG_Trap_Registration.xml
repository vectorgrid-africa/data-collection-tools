<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:entities="http://www.opendatakit.org/xforms/entities"><h:head><h:title>TRAP-REG: Trap Registration</h:title><model odk:xforms-version="1.0.0" entities:entities-version="2024.1.0"><instance><data id="vg_trap_reg" version="2026112015"><start/><end/><today/><deviceid/><username/><form_header/><sec1_geography><node_code/><country/><province/><district/><locality/><village_name/><village/></sec1_geography><sec1_registrar><registration_date/><collector_id/></sec1_registrar><sec2_trap><trap_id/><method/><co2_bait/><location/><outdoor_context/></sec2_trap><sec2_placement><household/><site_id/><site_gps/><hardware_serial/><placement_notes/></sec2_placement><household_ref/><status/><meta><entity dataset="traps" create="1" id=""><label/></entity><instanceID/><instanceName/></meta></data></instance><instance id="households" src="jr://file-csv/households.csv"/><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="trap_method"><root><item><name>1</name><label>DN - Double net trap</label></item><item><name>2</name><label>CDC - CDC light trap</label></item><item><name>3</name><label>RB - Resting bucket</label></item><item><name>4</name><label>PKP - Prokopack aspirator</label></item><item><name>5</name><label>BGS - BG Sentinel trap</label></item><item><name>6</name><label>Other</label></item></root></instance><instance id="trap_location"><root><item><name>1</name><label>Indoor</label></item><item><name>2</name><label>Outdoor</label></item></root></instance><instance id="outdoor_context"><root><item><name>1</name><label>Within 10 m of the house (peridomestic)</label></item><item><name>2</name><label>Other outdoor site</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_geography/node_code" type="string" required="true()" entities:saveto="node_code"/><bind nodeset="/data/sec1_geography/country" type="string" required="true()"/><bind nodeset="/data/sec1_geography/province" type="string" required="true()"/><bind nodeset="/data/sec1_geography/district" type="string" required="true()"/><bind nodeset="/data/sec1_geography/locality" type="string" required="true()"/><bind nodeset="/data/sec1_geography/village_name" type="string" required="true()"/><bind nodeset="/data/sec1_geography/village" type="string" required="true()" entities:saveto="village"/><bind nodeset="/data/sec1_registrar/registration_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future" entities:saveto="registration_date"/><setvalue ref="/data/sec1_registrar/registration_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_registrar/collector_id" type="string" required="true()"/><bind nodeset="/data/sec2_trap/trap_id" type="string" required="true()" entities:saveto="trap_id"/><bind nodeset="/data/sec2_trap/method" type="string" required="true()" entities:saveto="method"/><bind nodeset="/data/sec2_trap/co2_bait" type="string" required="true()" relevant=" /data/sec2_trap/method ='2'" entities:saveto="co2_bait"/><bind nodeset="/data/sec2_trap/location" type="string" required="true()" entities:saveto="location"/><bind nodeset="/data/sec2_trap/outdoor_context" type="string" required="true()" relevant=" /data/sec2_trap/location ='2'" entities:saveto="outdoor_context"/><bind nodeset="/data/sec2_placement/household" type="string" required="true()" relevant=" /data/sec2_trap/location ='1' or  /data/sec2_trap/outdoor_context ='1'" entities:saveto="household_id"/><bind nodeset="/data/sec2_placement/site_id" type="string" required="true()" relevant=" /data/sec2_trap/location ='2' and  /data/sec2_trap/outdoor_context ='2'" entities:saveto="site_id"/><bind nodeset="/data/sec2_placement/site_gps" type="geopoint" required="true()" relevant=" /data/sec2_trap/location ='2' and  /data/sec2_trap/outdoor_context ='2'" entities:saveto="geometry"/><bind nodeset="/data/sec2_placement/hardware_serial" type="string"/><bind nodeset="/data/sec2_placement/placement_notes" type="string" required=" /data/sec2_trap/method ='6'"/><bind nodeset="/data/household_ref" type="string" calculate="instance('households')/root/item[name= /data/sec2_placement/household ]/household_id"/><bind nodeset="/data/status" type="string" calculate="&quot;active&quot;" entities:saveto="status"/><bind nodeset="/data/meta/entity/@create" calculate="true()" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@id" readonly="true()" type="string"/><setvalue ref="/data/meta/entity/@id" event="odk-instance-first-load" value="uuid()"/><bind nodeset="/data/meta/entity/label" calculate=" /data/sec2_trap/trap_id " readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec2_trap/trap_id , &quot; - &quot;,  /data/sec1_registrar/registration_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># TRAP-REG: Trap Registration</label></input><group appearance="field-list" ref="/data/sec1_geography"><label>Section 1A: Administrative geography &amp; study node</label><input ref="/data/sec1_geography/node_code"><label>Node Code</label></input><input ref="/data/sec1_geography/country"><label>Country</label></input><input ref="/data/sec1_geography/province"><label>Province</label></input><input ref="/data/sec1_geography/district"><label>District</label></input><input ref="/data/sec1_geography/locality"><label>Locality</label></input><input ref="/data/sec1_geography/village_name"><label>Village Name</label></input><input ref="/data/sec1_geography/village"><label>Village ID</label><hint>Type it as on HH-REG; the household list is filtered by it.</hint></input></group><group appearance="field-list" ref="/data/sec1_registrar"><label>Section 1B: Trap deployment context &amp; registrar</label><input ref="/data/sec1_registrar/registration_date"><label>Date of Registration</label></input><input ref="/data/sec1_registrar/collector_id"><label>Collector / team ID</label></input></group><group appearance="field-list" ref="/data/sec2_trap"><label>Section 2: Trap deployment</label><input ref="/data/sec2_trap/trap_id"><label>Trap ID</label><hint>Format: Node-Village-T01</hint></input><select1 ref="/data/sec2_trap/method"><label>Method</label><itemset nodeset="instance('trap_method')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_trap/co2_bait"><label>CO2 bait</label><hint>CDC light trap only: does the registered setup use CO2 bait?</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_trap/location"><label>Location</label><itemset nodeset="instance('trap_location')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_trap/outdoor_context"><label>Outdoor context</label><itemset nodeset="instance('outdoor_context')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group appearance="field-list" ref="/data/sec2_placement"><label>Placement reference</label><select1 ref="/data/sec2_placement/household" appearance="search"><label>Household ID</label><itemset nodeset="instance('households')/root/item[village= /data/sec1_geography/village ]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_placement/site_id"><label>Site ID</label><hint>Other outdoor site: give the site ID</hint></input><input ref="/data/sec2_placement/site_gps" accuracyThreshold="5"><label>Site coordinates</label></input><input ref="/data/sec2_placement/hardware_serial"><label>Hardware serial / barcode</label></input><input ref="/data/sec2_placement/placement_notes"><label>Placement notes / microhabitat</label><hint>For method 6 (Other), specify the method here.</hint></input></group></h:body></h:html>