<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:entities="http://www.opendatakit.org/xforms/entities"><h:head><h:title>TRAP-REG: Trap Registration</h:title><model odk:xforms-version="1.0.0" entities:entities-version="2024.1.0"><instance><data id="vg_trap_reg" version="2026112101"><start/><end/><today/><deviceid/><username/><form_header/><basic_info><registration_date/><collector_id/><node_code/></basic_info><district/><trap_details><method/><method_other/><co2_bait/><indoor_outdoor/><outdoor_context/></trap_details><household_selection><household/><household_ref/></household_selection><site_info><site_id/><site_gps/></site_info><placement_info><hardware_serial/><placement_notes/></placement_info><trap_id/><trap_id_note/><status/><signature_info><full_name_signature/></signature_info><notes/><meta><entity dataset="traps" create="1" id=""><label/></entity><instanceID/><instanceName/></meta></data></instance><instance id="households" src="jr://file-csv/households.csv"/><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="collection_method"><root><item><name>DN</name><label>Double Net</label></item><item><name>CDC</name><label>CDC Light Trap</label></item><item><name>RB</name><label>Resting Bucket</label></item><item><name>PKP</name><label>Prokopack Aspirator</label></item><item><name>BGS</name><label>BG Sentinel</label></item><item><name>other</name><label>Other</label></item></root></instance><instance id="location_type"><root><item><name>IN</name><label>Indoor</label></item><item><name>OUT</name><label>Outdoor</label></item></root></instance><instance id="outdoor_context"><root><item><name>1</name><label>Within 10 m of the house (peridomestic)</label></item><item><name>2</name><label>Other outdoor site</label></item></root></instance><instance id="district"><root><item><name>kilombero</name><label>Kilombero</label></item><item><name>malinyi</name><label>Malinyi</label></item><item><name>mlimba</name><label>Mlimba</label></item><item><name>ulanga</name><label>Ulanga</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/basic_info/registration_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future" entities:saveto="registration_date"/><setvalue ref="/data/basic_info/registration_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/basic_info/collector_id" type="string" required="true()"/><bind nodeset="/data/basic_info/node_code" type="string" required="true()" entities:saveto="node_code"/><bind nodeset="/data/district" type="string" required="true()" entities:saveto="district"/><bind nodeset="/data/trap_details/method" type="string" required="true()" entities:saveto="method"/><bind nodeset="/data/trap_details/method_other" type="string" required="true()" relevant=" /data/trap_details/method ='other'"/><bind nodeset="/data/trap_details/co2_bait" type="string" required="true()" relevant=" /data/trap_details/method ='CDC'" entities:saveto="co2_bait"/><bind nodeset="/data/trap_details/indoor_outdoor" type="string" required="true()" entities:saveto="indoor_outdoor"/><bind nodeset="/data/trap_details/outdoor_context" type="string" required="true()" relevant=" /data/trap_details/indoor_outdoor ='OUT'" entities:saveto="outdoor_context"/><bind nodeset="/data/household_selection" relevant=" /data/trap_details/indoor_outdoor ='IN' or  /data/trap_details/outdoor_context ='1'"/><bind nodeset="/data/household_selection/household" type="string" required="true()" entities:saveto="household_id"/><bind nodeset="/data/household_selection/household_ref" type="string" calculate="instance('households')/root/item[name= /data/household_selection/household ]/household_id"/><bind nodeset="/data/site_info" relevant=" /data/trap_details/indoor_outdoor ='OUT' and  /data/trap_details/outdoor_context ='2'"/><bind nodeset="/data/site_info/site_id" type="string" required="true()" entities:saveto="site_id"/><bind nodeset="/data/site_info/site_gps" type="geopoint" required="true()" entities:saveto="geometry"/><bind nodeset="/data/placement_info/hardware_serial" type="string"/><bind nodeset="/data/placement_info/placement_notes" type="string"/><bind nodeset="/data/trap_id" type="string" calculate="concat(if( /data/trap_details/indoor_outdoor ='IN' or  /data/trap_details/outdoor_context ='1',  /data/household_selection/household_ref ,  /data/site_info/site_id ), &quot;-&quot;,  /data/trap_details/method , &quot;-&quot;,  /data/trap_details/indoor_outdoor )" entities:saveto="trap_id"/><bind nodeset="/data/trap_id_note" readonly="true()" type="string"/><bind nodeset="/data/status" type="string" calculate="&quot;active&quot;" entities:saveto="status"/><bind nodeset="/data/signature_info/full_name_signature" type="string" required="true()"/><bind nodeset="/data/notes" type="string"/><bind nodeset="/data/meta/entity/@create" calculate="true()" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@id" readonly="true()" type="string"/><setvalue ref="/data/meta/entity/@id" event="odk-instance-first-load" value="uuid()"/><bind nodeset="/data/meta/entity/label" calculate=" /data/trap_id " readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/trap_id , &quot; - &quot;,  /data/basic_info/registration_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># TRAP-REG: Trap Registration</label></input><group appearance="field-list" ref="/data/basic_info"><label>Basic Information</label><input ref="/data/basic_info/registration_date"><label>Registration date</label></input><input ref="/data/basic_info/collector_id"><label>Collector ID (registered staff ID)</label><hint>Your registered staff ID, not your name</hint></input><input ref="/data/basic_info/node_code"><label>Node Code</label></input></group><select1 ref="/data/district" appearance="minimal autocomplete"><label>Select district</label><hint>Filter households by district</hint><itemset nodeset="instance('district')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><group appearance="field-list" ref="/data/trap_details"><label>Trap Details</label><select1 ref="/data/trap_details/method"><label>Collection method</label><itemset nodeset="instance('collection_method')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/trap_details/method_other"><label>Specify other method</label></input><select1 ref="/data/trap_details/co2_bait"><label>CO2 bait used?</label><hint>CDC light trap only</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/trap_details/indoor_outdoor"><label>Indoor or Outdoor?</label><itemset nodeset="instance('location_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/trap_details/outdoor_context"><label>Outdoor placement</label><itemset nodeset="instance('outdoor_context')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/household_selection"><label>Household Selection</label><select1 ref="/data/household_selection/household" appearance="search"><label>Select household</label><hint>The household where the trap is placed</hint><itemset nodeset="instance('households')/root/item[district= /data/district ]"><value ref="name"/><label ref="label"/></itemset></select1></group><group appearance="field-list" ref="/data/site_info"><label>Collection Site</label><input ref="/data/site_info/site_id"><label>Site ID</label></input><input ref="/data/site_info/site_gps" accuracyThreshold="5"><label>GPS Location</label><hint>Capture site coordinates (within 5 m)</hint></input></group><group appearance="field-list" ref="/data/placement_info"><label>Placement</label><input ref="/data/placement_info/hardware_serial"><label>Serial / barcode</label></input><input ref="/data/placement_info/placement_notes"><label>Placement notes</label></input></group><input ref="/data/trap_id_note"><label> **Trap ID:** <output value=" /data/trap_id "/> </label></input><group appearance="field-list" ref="/data/signature_info"><label>Signature</label><input ref="/data/signature_info/full_name_signature"><label>Full name (as signature)</label><hint>Type your full name</hint></input></group><input ref="/data/notes"><label>Additional notes</label></input></h:body></h:html>