<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>HH-BEH: Human Behaviour Observation</h:title><model odk:xforms-version="1.0.0"><instance><data id="vg_hh_beh" version="2026112401"><start/><end/><today/><deviceid/><username/><form_header/><sec1_links><district/><household/></sec1_links><node_code/><household_id/><hh_village/><hh_ward/><household_note/><sec1_event><survey_date/><collector_id/><method/><visit_id/><visit_id_note/></sec1_event><sec2_household><people_present/><functional_nets/><has_interventions/><interventions/><interventions_other/></sec2_household><out_shifts jr:template=""><out_shift><out_shift_type/><out_volunteer_code/><out_gender/><out_shift_date/><out_start_time/><out_end_time/></out_shift></out_shifts><out_shifts><out_shift><out_shift_type/><out_volunteer_code/><out_gender/><out_shift_date/><out_start_time/><out_end_time/></out_shift></out_shifts><sec3_outdoor><out_sleeping_net/><out_awake_net/><out_no_net_total/><out_no_net_under5/></sec3_outdoor><in_shifts jr:template=""><in_shift><in_shift_type/><in_volunteer_code/><in_gender/><in_shift_date/><in_start_time/><in_end_time/></in_shift></in_shifts><in_shifts><in_shift><in_shift_type/><in_volunteer_code/><in_gender/><in_shift_date/><in_start_time/><in_end_time/></in_shift></in_shifts><sec4_indoor><in_sleeping_net/><in_awake_net/><in_no_net_total/><in_no_net_under5/></sec4_indoor><people_counted/><people_check/><sec5_note/><hours jr:template=""><hour_info><hour_date/><hour_time/><hour_location/><hour_shift/><hour_volunteer/><cup_id/><cup_id_note/><observation/><mosquito_count/><missed_reason/><num_interruptions>0</num_interruptions></hour_info><interruptions jr:template=""><interruption_info><exit_time/><return_time/><interruption_reason/></interruption_info></interruptions></hours><hours><hour_info><hour_date/><hour_time/><hour_location/><hour_shift/><hour_volunteer/><cup_id/><cup_id_note/><observation/><mosquito_count/><missed_reason/><num_interruptions>0</num_interruptions></hour_info><interruptions><interruption_info><exit_time/><return_time/><interruption_reason/></interruption_info></interruptions></hours><notes/><signature_info><full_name_signature/></signature_info><meta><instanceID/><instanceName/></meta></data></instance><instance id="households" src="jr://file-csv/households.csv"/><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="interventions"><root><item><name>itn</name><label>ITN</label></item><item><name>irs</name><label>IRS</label></item><item><name>mda_ivermectin</name><label>MDA-Ivermectin</label></item><item><name>lsm</name><label>LSM</label></item><item><name>other</name><label>Other</label></item></root></instance><instance id="beh_method"><root><item><name>1</name><label>DN-Mini</label></item><item><name>2</name><label>HLC</label></item></root></instance><instance id="interventions_between"><root><item><name>1</name><label>Yes (ITN, MDA-Ivermectin, LSM, or IRS introduced)</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="shift"><root><item><name>day</name><label>Day</label></item><item><name>night</name><label>Night</label></item></root></instance><instance id="gender"><root><item><name>1</name><label>Female</label></item><item><name>2</name><label>Male</label></item><item><name>3</name><label>Transgender</label></item><item><name>4</name><label>I prefer not to disclose</label></item></root></instance><instance id="location"><root><item><name>indoor</name><label>Indoor</label></item><item><name>outdoor</name><label>Outdoor</label></item></root></instance><instance id="observation"><root><item><name>complete</name><label>Complete</label></item><item><name>partial</name><label>Partial</label></item><item><name>missed</name><label>Missed</label></item></root></instance><instance id="district"><root><item><name>kilombero</name><label>Kilombero</label></item><item><name>malinyi</name><label>Malinyi</label></item><item><name>mlimba</name><label>Mlimba</label></item><item><name>ulanga</name><label>Ulanga</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_links/district" type="string" required="true()"/><bind nodeset="/data/sec1_links/household" type="string" required="true()"/><bind nodeset="/data/node_code" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/node_code"/><bind nodeset="/data/household_id" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/household_id"/><bind nodeset="/data/hh_village" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/village"/><bind nodeset="/data/hh_ward" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/ward"/><bind nodeset="/data/household_note" readonly="true()" type="string" relevant=" /data/sec1_links/household  != ''"/><bind nodeset="/data/sec1_event/survey_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future"/><setvalue ref="/data/sec1_event/survey_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_event/collector_id" type="string" required="true()"/><bind nodeset="/data/sec1_event/method" type="string" required="true()"/><bind nodeset="/data/sec1_event/visit_id" type="string" calculate="concat( /data/household_id , &quot;-&quot;, format-date( /data/sec1_event/survey_date , &quot;%Y%m%d&quot;))"/><bind nodeset="/data/sec1_event/visit_id_note" readonly="true()" type="string" relevant=" /data/sec1_links/household  != ''"/><bind nodeset="/data/sec2_household/people_present" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec2_household/functional_nets" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 50"/><bind nodeset="/data/sec2_household/has_interventions" type="string" required="true()"/><bind nodeset="/data/sec2_household/interventions" type="string" required="true()" relevant=" /data/sec2_household/has_interventions ='1'"/><bind nodeset="/data/sec2_household/interventions_other" type="string" required="true()" relevant="selected( /data/sec2_household/interventions , 'other')"/><bind nodeset="/data/out_shifts/out_shift/out_shift_type" type="string" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_volunteer_code" type="string" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_gender" type="string" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_shift_date" type="date" required="true()"/><setvalue ref="/data/out_shifts/out_shift/out_shift_date" event="odk-instance-first-load" value=" /data/sec1_event/survey_date "/><bind nodeset="/data/out_shifts/out_shift/out_start_time" type="time" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_end_time" type="time" required="true()"/><bind nodeset="/data/sec3_outdoor/out_sleeping_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_outdoor/out_awake_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_outdoor/out_no_net_total" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_outdoor/out_no_net_under5" type="int" required="true()" constraint=". &gt;= 0 and . &lt;=  /data/sec3_outdoor/out_no_net_total " jr:constraintMsg="Children under 5 are included in the total, so cannot exceed it"/><bind nodeset="/data/in_shifts/in_shift/in_shift_type" type="string" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_volunteer_code" type="string" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_gender" type="string" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_shift_date" type="date" required="true()"/><setvalue ref="/data/in_shifts/in_shift/in_shift_date" event="odk-instance-first-load" value=" /data/sec1_event/survey_date "/><bind nodeset="/data/in_shifts/in_shift/in_start_time" type="time" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_end_time" type="time" required="true()"/><bind nodeset="/data/sec4_indoor/in_sleeping_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec4_indoor/in_awake_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec4_indoor/in_no_net_total" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec4_indoor/in_no_net_under5" type="int" required="true()" constraint=". &gt;= 0 and . &lt;=  /data/sec4_indoor/in_no_net_total " jr:constraintMsg="Children under 5 are included in the total, so cannot exceed it"/><bind nodeset="/data/people_counted" type="string" calculate="coalesce( /data/sec3_outdoor/out_sleeping_net , 0) + coalesce( /data/sec3_outdoor/out_awake_net , 0) + coalesce( /data/sec3_outdoor/out_no_net_total , 0) + coalesce( /data/sec4_indoor/in_sleeping_net , 0) + coalesce( /data/sec4_indoor/in_awake_net , 0) + coalesce( /data/sec4_indoor/in_no_net_total , 0)"/><bind nodeset="/data/people_check" readonly="true()" type="string" relevant=" /data/people_counted  &gt;  /data/sec2_household/people_present "/><bind nodeset="/data/sec5_note" readonly="true()" type="string"/><bind nodeset="/data/hours/hour_info/hour_date" type="date" required="true()"/><setvalue ref="/data/hours/hour_info/hour_date" event="odk-instance-first-load" value=" /data/sec1_event/survey_date "/><bind nodeset="/data/hours/hour_info/hour_time" type="time" required="true()"/><bind nodeset="/data/hours/hour_info/hour_location" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/hour_shift" type="string" calculate="if( ../hour_time  = '', '', if(number(substr( ../hour_time , 0, 2)) &gt;= 6 and number(substr( ../hour_time , 0, 2)) &lt; 18, 'day', 'night'))"/><bind nodeset="/data/hours/hour_info/hour_volunteer" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/cup_id" type="string" calculate="concat( /data/household_id , &quot;-&quot;,  ../hour_location , &quot;-&quot;, format-date( ../hour_date , &quot;%Y%m%d&quot;), &quot;-&quot;, substr( ../hour_time , 0, 2), substr( ../hour_time , 3, 5))"/><bind nodeset="/data/hours/hour_info/cup_id_note" readonly="true()" type="string" relevant=" ../hour_time  != '' and  ../hour_location  != ''"/><bind nodeset="/data/hours/hour_info/observation" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/mosquito_count" type="int" required="true()" constraint=". &gt;= 0" relevant=" ../observation  != 'missed'"/><bind nodeset="/data/hours/hour_info/missed_reason" type="string" required="true()" relevant=" ../observation ='missed'"/><bind nodeset="/data/hours/hour_info/num_interruptions" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 10" relevant=" ../observation  != 'missed'"/><bind nodeset="/data/hours/interruptions" relevant=" ../hour_info/num_interruptions  &gt; 0"/><bind nodeset="/data/hours/interruptions/interruption_info/exit_time" type="time" required="true()"/><bind nodeset="/data/hours/interruptions/interruption_info/return_time" type="time" required="true()"/><bind nodeset="/data/hours/interruptions/interruption_info/interruption_reason" type="string" required="true()"/><bind nodeset="/data/notes" type="string"/><bind nodeset="/data/signature_info/full_name_signature" type="string" required="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/household_id , &quot; - &quot;,  /data/sec1_event/survey_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># HH-BEH: Human Behaviour Observation</label></input><group appearance="field-list" ref="/data/sec1_links"><label>Household Selection</label><select1 ref="/data/sec1_links/district" appearance="minimal autocomplete"><label>Select district</label><hint>Filter households by district</hint><itemset nodeset="instance('district')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec1_links/household" appearance="search"><label>Select household</label><itemset nodeset="instance('households')/root/item[district= /data/sec1_links/district  and status=&quot;active&quot;]"><value ref="name"/><label ref="label"/></itemset></select1></group><input ref="/data/household_note"><label> **Household:** <output value=" /data/household_id "/> | **Village:** <output value=" /data/hh_village "/>, <output value=" /data/hh_ward "/> | **Node:** <output value=" /data/node_code "/> </label></input><group appearance="field-list" ref="/data/sec1_event"><label>Biannual Contact Sampling Event</label><input ref="/data/sec1_event/survey_date"><label>Date of Survey</label></input><input ref="/data/sec1_event/collector_id"><label>Collector ID (registered staff ID)</label><hint>Your registered staff ID, not your name</hint></input><select1 ref="/data/sec1_event/method"><label>Method</label><itemset nodeset="instance('beh_method')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_event/visit_id_note"><label> **Visit ID:** <output value=" /data/sec1_event/visit_id "/> </label></input></group><group ref="/data/sec2_household"><label>Household Visit &amp; Interventions Between Rounds</label><input ref="/data/sec2_household/people_present"><label>Total people present last night</label><hint>Total people present and sleeping at the household last night</hint></input><input ref="/data/sec2_household/functional_nets"><label>Total functional bed nets in house</label><hint>Total functional bed nets currently available and owned by household</hint></input><select1 ref="/data/sec2_household/has_interventions"><label>Interventions between biannual rounds</label><itemset nodeset="instance('interventions_between')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select ref="/data/sec2_household/interventions"><label>Interventions introduced</label><hint>Select all that apply</hint><itemset nodeset="instance('interventions')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/sec2_household/interventions_other"><label>Specify other intervention</label></input></group><group ref="/data/out_shifts"><label>Outdoor volunteer profile &amp; timing</label><repeat nodeset="/data/out_shifts"><group appearance="field-list" ref="/data/out_shifts/out_shift"><label>Outdoor volunteer profile &amp; timing</label><select1 ref="/data/out_shifts/out_shift/out_shift_type"><label>Shift</label><itemset nodeset="instance('shift')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/out_shifts/out_shift/out_volunteer_code"><label>Volunteer code</label></input><select1 ref="/data/out_shifts/out_shift/out_gender"><label>Gender</label><itemset nodeset="instance('gender')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/out_shifts/out_shift/out_shift_date"><label>Shift start date</label></input><input ref="/data/out_shifts/out_shift/out_start_time"><label>Start time</label></input><input ref="/data/out_shifts/out_shift/out_end_time"><label>End time</label></input></group><setvalue ref="/data/out_shifts/out_shift/out_shift_date" event="odk-new-repeat" value=" /data/sec1_event/survey_date "/></repeat></group><group ref="/data/sec3_outdoor"><label>Outdoor Contact &amp; Sleeping Patterns</label><input ref="/data/sec3_outdoor/out_sleeping_net"><label>People sleeping under net outdoors</label><hint>Number of people sleeping under a bed net outside the house last night</hint></input><input ref="/data/sec3_outdoor/out_awake_net"><label>People awake under net outdoors</label><hint>Number of people awake under a bed net outside the house last night</hint></input><input ref="/data/sec3_outdoor/out_no_net_total"><label>People sleeping outdoors without net - total</label><hint>Total people (and children &lt;5y) sleeping outdoors with NO bed net</hint></input><input ref="/data/sec3_outdoor/out_no_net_under5"><label>People sleeping outdoors without net - children under 5</label></input></group><group ref="/data/in_shifts"><label>Indoor volunteer profile &amp; timing</label><repeat nodeset="/data/in_shifts"><group appearance="field-list" ref="/data/in_shifts/in_shift"><label>Indoor volunteer profile &amp; timing</label><select1 ref="/data/in_shifts/in_shift/in_shift_type"><label>Shift</label><itemset nodeset="instance('shift')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/in_shifts/in_shift/in_volunteer_code"><label>Volunteer code</label></input><select1 ref="/data/in_shifts/in_shift/in_gender"><label>Gender</label><itemset nodeset="instance('gender')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/in_shifts/in_shift/in_shift_date"><label>Shift start date</label></input><input ref="/data/in_shifts/in_shift/in_start_time"><label>Start time</label></input><input ref="/data/in_shifts/in_shift/in_end_time"><label>End time</label></input></group><setvalue ref="/data/in_shifts/in_shift/in_shift_date" event="odk-new-repeat" value=" /data/sec1_event/survey_date "/></repeat></group><group ref="/data/sec4_indoor"><label>Indoor Contact &amp; Sleeping Patterns</label><input ref="/data/sec4_indoor/in_sleeping_net"><label>People sleeping under net indoors</label><hint>Number of people sleeping under a bed net inside the house last night</hint></input><input ref="/data/sec4_indoor/in_awake_net"><label>People awake under net indoors</label><hint>Number of people awake under a bed net inside the house last night</hint></input><input ref="/data/sec4_indoor/in_no_net_total"><label>People indoors without a bed net - total</label><hint>Count everyone indoors without a bed net last night, awake or asleep. Include children under five in the total and record their count separately.</hint></input><input ref="/data/sec4_indoor/in_no_net_under5"><label>People indoors without a bed net - children under 5</label></input></group><input ref="/data/people_check"><label> **Warning:** <output value=" /data/people_counted "/> people counted indoors and outdoors, but <output value=" /data/sec2_household/people_present "/> were present last night. Please check the counts. </label></input><input ref="/data/sec5_note"><label>## Hourly observations

Day shift 06:00-18:00. Night shift 18:00-06:00. Add one entry for each hour and location. Match each cup to the node, household, location, shift, date and hour on its label.</label></input><group ref="/data/hours"><label>Hourly observation</label><repeat nodeset="/data/hours"><group appearance="field-list" ref="/data/hours/hour_info"><label>Hourly observation</label><input ref="/data/hours/hour_info/hour_date"><label>Hour start - date</label></input><input ref="/data/hours/hour_info/hour_time"><label>Hour start - time</label></input><select1 ref="/data/hours/hour_info/hour_location"><label>Location</label><itemset nodeset="instance('location')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/hours/hour_info/hour_volunteer"><label>Volunteer code</label></input><input ref="/data/hours/hour_info/cup_id_note"><label> **Shift:** <output value=" ../hour_shift "/> | **Cup ID:** <output value=" ../cup_id "/> (write it on the cup) </label></input><select1 ref="/data/hours/hour_info/observation"><label>Observation</label><itemset nodeset="instance('observation')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/hours/hour_info/mosquito_count"><label>Mosquito count</label><hint>Enter the observed count, including 0.</hint></input><input ref="/data/hours/hour_info/missed_reason"><label>Reason the hour was missed</label></input><input ref="/data/hours/hour_info/num_interruptions"><label>Number of interruptions in this hour</label></input></group><group ref="/data/hours/interruptions"><label>Interruption</label><repeat nodeset="/data/hours/interruptions" jr:count=" ../hour_info/num_interruptions "><group appearance="field-list" ref="/data/hours/interruptions/interruption_info"><label>Interruption</label><input ref="/data/hours/interruptions/interruption_info/exit_time"><label>Exit time</label></input><input ref="/data/hours/interruptions/interruption_info/return_time"><label>Return time</label></input><input ref="/data/hours/interruptions/interruption_info/interruption_reason"><label>Reason</label></input></group></repeat></group><setvalue ref="/data/hours/hour_info/hour_date" event="odk-new-repeat" value=" /data/sec1_event/survey_date "/></repeat></group><input ref="/data/notes" appearance="multiline"><label>Field observer notes</label></input><group appearance="field-list" ref="/data/signature_info"><label>Signature</label><input ref="/data/signature_info/full_name_signature"><label>Full name (as signature)</label><hint>Type your full name</hint></input></group></h:body></h:html>