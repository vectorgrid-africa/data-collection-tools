our_date/><hour_time/><hour_location/><hour_shift/><hour_volunteer/><cup_id/><observation/><mosquito_count/><missed_reason/><num_interruptions>0</num_interruptions></hour_info><interruptions><interruption_info><exit_time/><return_time/><interruption_reason/></interruption_info></interruptions></hours><observer_notes/><meta><instanceID/><instanceName/></meta></data></instance><instance id="households" src="jr://file-csv/households.csv"/><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="beh_method"><root><item><name>1</name><label>DN-Mini</label></item><item><name>2</name><label>HLC</label></item></root></instance><instance id="interventions_between"><root><item><name>1</name><label>Yes (ITN, MDA-Ivermectin, LSM, or IRS introduced)</label></item><item><name>0</name><label>None</label></item></root></instance><instance id="shift"><root><item><name>day</name><label>Day</label></item><item><name>night</name><label>Night</label></item></root></instance><instance id="gender"><root><item><name>1</name><label>Female</label></item><item><name>2</name><label>Male</label></item><item><name>3</name><label>Transgender</label></item><item><name>4</name><label>I prefer not to disclose</label></item></root></instance><instance id="location"><root><item><name>indoor</name><label>Indoor</label></item><item><name>outdoor</name><label>Outdoor</label></item></root></instance><instance id="observation"><root><item><name>complete</name><label>Complete</label></item><item><name>partial</name><label>Partial</label></item><item><name>missed</name><label>Missed</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_links/village" type="string" required="true()"/><bind nodeset="/data/sec1_links/household" type="string" required="true()"/><bind nodeset="/data/sec1_links/visit_id" type="string" required="true()"/><bind nodeset="/data/node_code" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/node_code"/><bind nodeset="/data/household_id" type="string" calculate="instance('households')/root/item[name= /data/sec1_links/household ]/household_id"/><bind nodeset="/data/household_note" readonly="true()" type="string" relevant=" /data/sec1_links/household  != ''"/><bind nodeset="/data/sec1_event/survey_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future"/><setvalue ref="/data/sec1_event/survey_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_event/collector_id" type="string" required="true()"/><bind nodeset="/data/sec1_event/method" type="string" required="true()"/><bind nodeset="/data/sec2_household/q01_people_present" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec2_household/q02_nets" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 50"/><bind nodeset="/data/sec2_household/q03_interventions" type="string" required="true()"/><bind nodeset="/data/sec2_household/q03_desc" type="string" required="true()" relevant=" /data/sec2_household/q03_interventions ='1'"/><bind nodeset="/data/out_shifts/out_shift/out_shift_type" type="string" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_volunteer_code" type="string" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_gender" type="string" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_shift_date" type="date" required="true()"/><setvalue ref="/data/out_shifts/out_shift/out_shift_date" event="odk-instance-first-load" value=" /data/sec1_event/survey_date "/><bind nodeset="/data/out_shifts/out_shift/out_start_time" type="time" required="true()"/><bind nodeset="/data/out_shifts/out_shift/out_end_time" type="time" required="true()"/><bind nodeset="/data/sec3_outdoor/q05_out_sleep_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_outdoor/q06_out_awake_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_outdoor/q07_out_no_net_total" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec3_outdoor/q07_out_no_net_under5" type="int" required="true()" constraint=". &gt;= 0 and . &lt;=  /data/sec3_outdoor/q07_out_no_net_total " jr:constraintMsg="Children under 5 are included in the total, so cannot exceed it"/><bind nodeset="/data/in_shifts/in_shift/in_shift_type" type="string" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_volunteer_code" type="string" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_gender" type="string" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_shift_date" type="date" required="true()"/><setvalue ref="/data/in_shifts/in_shift/in_shift_date" event="odk-instance-first-load" value=" /data/sec1_event/survey_date "/><bind nodeset="/data/in_shifts/in_shift/in_start_time" type="time" required="true()"/><bind nodeset="/data/in_shifts/in_shift/in_end_time" type="time" required="true()"/><bind nodeset="/data/sec4_indoor/q09_in_sleep_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec4_indoor/q10_in_awake_net" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec4_indoor/q11_in_no_net_total" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 100"/><bind nodeset="/data/sec4_indoor/q11_in_no_net_under5" type="int" required="true()" constraint=". &gt;= 0 and . &lt;=  /data/sec4_indoor/q11_in_no_net_total " jr:constraintMsg="Children under 5 are included in the total, so cannot exceed it"/><bind nodeset="/data/sec5_note" readonly="true()" type="string"/><bind nodeset="/data/hours/hour_info/hour_date" type="date" required="true()"/><setvalue ref="/data/hours/hour_info/hour_date" event="odk-instance-first-load" value=" /data/sec1_event/survey_date "/><bind nodeset="/data/hours/hour_info/hour_time" type="time" required="true()"/><bind nodeset="/data/hours/hour_info/hour_location" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/hour_shift" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/hour_volunteer" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/cup_id" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/observation" type="string" required="true()"/><bind nodeset="/data/hours/hour_info/mosquito_count" type="int" required="true()" constraint=". &gt;= 0" relevant=" ../observation  != 'missed'"/><bind nodeset="/data/hours/hour_info/missed_reason" type="string" required="true()" relevant=" ../observation ='missed'"/><bind nodeset="/data/hours/hour_info/num_interruptions" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 10" relevant=" ../observation  != 'missed'"/><bind nodeset="/data/hours/interruptions" relevant=" ../hour_info/num_interruptions  &gt; 0"/><bind nodeset="/data/hours/interruptions/interruption_info/exit_time" type="time" required="true()"/><bind nodeset="/data/hours/interruptions/interruption_info/return_time" type="time" required="true()"/><bind nodeset="/data/hours/interruptions/interruption_info/interruption_reason" type="string" required="true()"/><bind nodeset="/data/observer_notes" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/household_id , &quot; - &quot;,  /data/sec1_event/survey_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># HH-BEH: Human Behaviour Observation</label></input><group appearance="field-list" ref="/data/sec1_links"><label>Section 1A: Study node &amp; site links</label><input ref="/data/sec1_links/village"><label>Village ID</label><hint>Type it as on HH-REG; the household list is filtered by it.</hint></input><select1 ref="/data/sec1_links/household" appearance="search"><label>Household ID</label><itemset nodeset="instance('households')/root/item[village= /data/sec1_links/village  and status=&quot;active&quot;]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_links/visit_id"><label>Visit ID</label></input></group><input ref="/data/household_note"><label> Node: <output value=" /data/node_code "/> | Household: <output value=" /data/household_id "/> </label></input><group appearance="field-list" ref="/data/sec1_event"><label>Section 1B: Biannual contact sampling event</label><input ref="/data/sec1_event/survey_date"><label>Date of Survey</label></input><input ref="/data/sec1_event/collector_id"><label>Collector / team ID</label></input><select1 ref="/data/sec1_event/method"><label>Method</label><itemset nodeset="instance('beh_method')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/sec2_household"><label>Section 2: Household visit &amp; interventions between rounds</label><input ref="/data/sec2_household/q01_people_present"><label>Q01. Total people present last night</label><hint>Total people present and sleeping at the household last night</hint></input><input ref="/data/sec2_household/q02_nets"><label>Q02. Total functional bed nets in house</label><hint>Total functional bed nets currently available and owned by household</hint></input><select1 ref="/data/sec2_household/q03_interventions"><label>Q03. Interventions between biannual rounds</label><itemset nodeset="instance('interventions_between')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_household/q03_desc"><label>Q03. Describe the interventions</label></input></group><group ref="/data/out_shifts"><label>Q04. Outdoor volunteer profile &amp; timing</label><repeat nodeset="/data/out_shifts"><group appearance="field-list" ref="/data/out_shifts/out_shift"><label>Q04. Outdoor volunteer profile &amp; timing</label><select1 ref="/data/out_shifts/out_shift/out_shift_type"><label>Shift</label><itemset nodeset="instance('shift')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/out_shifts/out_shift/out_volunteer_code"><label>Volunteer code</label></input><select1 ref="/data/out_shifts/out_shift/out_gender"><label>Gender</label><itemset nodeset="instance('gender')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/out_shifts/out_shift/out_shift_date"><label>Shift start date</label></input><input ref="/data/out_shifts/out_shift/out_start_time"><label>Start time</label></input><input ref="/data/out_shifts/out_shift/out_end_time"><label>End time</label></input></group><setvalue ref="/data/out_shifts/out_shift/out_shift_date" event="odk-new-repeat" value=" /data/sec1_event/survey_date "/></repeat></group><group ref="/data/sec3_outdoor"><label>Section 3: Outdoor contact &amp; sleeping patterns</label><input ref="/data/sec3_outdoor/q05_out_sleep_net"><label>Q05. People sleeping under net outdoors</label><hint>Number of people sleeping under a bed net outside the house last night</hint></input><input ref="/data/sec3_outdoor/q06_out_awake_net"><label>Q06. People awake under net outdoors</label><hint>Number of people awake under a bed net outside the house last night</hint></input><input ref="/data/sec3_outdoor/q07_out_no_net_total"><label>Q07. People sleeping outdoors without net - total</label><hint>Total people (and children &lt;5y) sleeping outdoors with NO bed net</hint></input><input ref="/data/sec3_outdoor/q07_out_no_net_under5"><label>Q07. People sleeping outdoors without net - children under 5</label></input></group><group ref="/data/in_shifts"><label>Q08. Indoor volunteer profile &amp; timing</label><repeat nodeset="/data/in_shifts"><group appearance="field-list" ref="/data/in_shifts/in_shift"><label>Q08. Indoor volunteer profile &amp; timing</label><select1 ref="/data/in_shifts/in_shift/in_shift_type"><label>Shift</label><itemset nodeset="instance('shift')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/in_shifts/in_shift/in_volunteer_code"><label>Volunteer code</label></input><select1 ref="/data/in_shifts/in_shift/in_gender"><label>Gender</label><itemset nodeset="instance('gender')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/in_shifts/in_shift/in_shift_date"><label>Shift start date</label></input><input ref="/data/in_shifts/in_shift/in_start_time"><label>Start time</label></input><input ref="/data/in_shifts/in_shift/in_end_time"><label>End time</label></input></group><setvalue ref="/data/in_shifts/in_shift/in_shift_date" event="odk-new-repeat" value=" /data/sec1_event/survey_date "/></repeat></group><group ref="/data/sec4_indoor"><label>Section 4: Indoor contact &amp; sleeping patterns</label><input ref="/data/sec4_indoor/q09_in_sleep_net"><label>Q09. People sleeping under net indoors</label><hint>Number of people sleeping under a bed net inside the house last night</hint></input><input ref="/data/sec4_indoor/q10_in_awake_net"><label>Q10. People awake under net indoors</label><hint>Number of people awake under a bed net inside the house last night</hint></input><input ref="/data/sec4_indoor/q11_in_no_net_total"><label>Q11. People indoors without a bed net - total</label><hint>Count everyone indoors without a bed net last night, awake or asleep. Include children under five in the total and record their count separately.</hint></input><input ref="/data/sec4_indoor/q11_in_no_net_under5"><label>Q11. People indoors without a bed net - children under 5</label></input></group><input ref="/data/sec5_note"><label>## Section 5: Hourly observations

Day shift 06:00-18:00. Night shift 18:00-06:00. Add one entry for each hour and location. Match each cup to the node, household, location, shift, date and hour on its label.</label></input><group ref="/data/hours"><label>Hourly observation</label><repeat nodeset="/data/hours"><group appearance="field-list" ref="/data/hours/hour_info"><label>Hourly observation</label><input ref="/data/hours/hour_info/hour_date"><label>Hour start - date</label></input><input ref="/data/hours/hour_info/hour_time"><label>Hour start - time</label></input><select1 ref="/data/hours/hour_info/hour_location"><label>Location</label><itemset nodeset="instance('location')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/hours/hour_info/hour_shift"><label>Shift</label><itemset nodeset="instance('shift')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/hours/hour_info/hour_volunteer"><label>Volunteer code</label></input><input ref="/data/hours/hour_info/cup_id"><label>Cup ID</label></input><select1 ref="/data/hours/hour_info/observation"><label>Observation</label><itemset nodeset="instance('observation')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/hours/hour_info/mosquito_count"><label>Mosquito count</label><hint>Enter the observed count, including 0.</hint></input><input ref="/data/hours/hour_info/missed_reason"><label>Reason the hour was missed</label></input><input ref="/data/hours/hour_info/num_interruptions"><label>Number of interruptions in this hour</label></input></group><group ref="/data/hours/interruptions"><label>Interruption</label><repeat nodeset="/data/hours/interruptions" jr:count=" ../hour_info/num_interruptions "><group appearance="field-list" ref="/data/hours/interruptions/interruption_info"><label>Interruption</label><input ref="/data/hours/interruptions/interruption_info/exit_time"><label>Exit time</label></input><input ref="/data/hours/interruptions/interruption_info/return_time"><label>Return time</label></input><input ref="/data/hours/interruptions/interruption_info/interruption_reason"><label>Reason</label></input></group></repeat></group><setvalue ref="/data/hours/hour_info/hour_date" event="odk-new-repeat" value=" /data/sec1_event/survey_date "/></repeat></group><input ref="/data/observer_notes" appearance="multiline"><label>Field observer notes</label></input></h:body></h:html>