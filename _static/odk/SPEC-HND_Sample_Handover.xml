<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>SPEC-HND: Sample Handover and Custody</h:title><model odk:xforms-version="1.0.0"><instance><data id="vg_spec_hnd" version="2026112101"><start/><end/><today/><deviceid/><username/><form_header/><sec1_routing><node_code/><country/><destination_lab/><waybill_id/></sec1_routing><sec1_dispatch><dispatch_date/><dispatch_time/><officer_id/><container_id/></sec1_dispatch><sec2_cold_chain><dispatch_temp/><dispatch_initials/><receipt_temp/><receipt_initials/><cold_chain_breach/><logger_deployed/><logger_id/></sec2_cold_chain><manifest_note/><num_rows/><manifest jr:template=""><row_number/><manifest_row><batch_id/><record_id/><sampling_method/><sampling_method_other/><specimen_category/><specimen_category_other/><container_qty/><medium/><medium_other/><storage_condition/><integrity/><intake/><exception_reason/></manifest_row></manifest><manifest><row_number/><manifest_row><batch_id/><record_id/><sampling_method/><sampling_method_other/><specimen_category/><specimen_category_other/><container_qty/><medium/><medium_other/><storage_condition/><integrity/><intake/><exception_reason/></manifest_row></manifest><rows_used/><total_containers/><records_list/><form_summary><sum_header/><sum_dispatch/><sum_logger/><sum_no_logger/><sum_manifest/><sum_breach/><summary_confirmed/></form_summary><stage1_signoff><stage1_name/><stage1_signature/><stage1_datetime/></stage1_signoff><stage2_signoff><stage2_name/><stage2_signature/><stage2_datetime/></stage2_signoff><stage3_signoff><stage3_name/><stage3_signature/><stage3_datetime/></stage3_signoff><archive_note/><meta><instanceID/><instanceName/></meta></data></instance><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="cold_chain"><root><item><name>1</name><label>No breach (intact)</label></item><item><name>2</name><label>Breach / spike</label></item></root></instance><instance id="sampling_method"><root><item><name>1</name><label>Double net</label></item><item><name>2</name><label>CDC</label></item><item><name>3</name><label>Resting bucket</label></item><item><name>4</name><label>Prokopack</label></item><item><name>5</name><label>BG Sentinel</label></item><item><name>6</name><label>Other (write in)</label></item><item><name>7</name><label>Larval</label></item></root></instance><instance id="specimen_category"><root><item><name>1</name><label>Anopheles female</label></item><item><name>2</name><label>Anopheles male</label></item><item><name>3</name><label>Culicine</label></item><item><name>4</name><label>Larval</label></item><item><name>5</name><label>Parts</label></item><item><name>99</name><label>Other taxa or category (write in)</label></item></root></instance><instance id="medium"><root><item><name>1</name><label>Ethanol</label></item><item><name>2</name><label>RNAlater</label></item><item><name>3</name><label>Silica</label></item><item><name>0</name><label>None</label></item><item><name>99</name><label>Other (write in)</label></item></root></instance><instance id="integrity"><root><item><name>1</name><label>Intact</label></item><item><name>2</name><label>Leak / damage</label></item></root></instance><instance id="intake"><root><item><name>1</name><label>Accepted</label></item><item><name>2</name><label>Hold / reject</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/sec1_routing/node_code" type="string" required="true()"/><bind nodeset="/data/sec1_routing/country" type="string" calculate="&quot;Tanzania&quot;"/><bind nodeset="/data/sec1_routing/destination_lab" type="string" required="true()"/><bind nodeset="/data/sec1_routing/waybill_id" type="string" required="true()"/><bind nodeset="/data/sec1_dispatch/dispatch_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future"/><setvalue ref="/data/sec1_dispatch/dispatch_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_dispatch/dispatch_time" type="time" required="true()"/><bind nodeset="/data/sec1_dispatch/officer_id" type="string" required="true()"/><bind nodeset="/data/sec1_dispatch/container_id" type="string" required="true()"/><bind nodeset="/data/sec2_cold_chain/dispatch_temp" type="decimal" required="true()" constraint=". &gt;= -100 and . &lt;= 50"/><bind nodeset="/data/sec2_cold_chain/dispatch_initials" type="string" required="true()"/><bind nodeset="/data/sec2_cold_chain/receipt_temp" type="decimal" constraint=". &gt;= -100 and . &lt;= 50"/><bind nodeset="/data/sec2_cold_chain/receipt_initials" type="string" required=" /data/sec2_cold_chain/receipt_temp  != ''"/><bind nodeset="/data/sec2_cold_chain/cold_chain_breach" type="string"/><bind nodeset="/data/sec2_cold_chain/logger_deployed" type="string" required="true()"/><bind nodeset="/data/sec2_cold_chain/logger_id" type="string" required="true()" relevant=" /data/sec2_cold_chain/logger_deployed ='1'"/><bind nodeset="/data/manifest_note" readonly="true()" type="string"/><bind nodeset="/data/num_rows" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 20" jr:constraintMsg="Enter 1-20"/><bind nodeset="/data/manifest/row_number" type="string" calculate="position(..)"/><bind nodeset="/data/manifest/manifest_row/batch_id" type="string" required="true()"/><bind nodeset="/data/manifest/manifest_row/record_id" type="string" required="true()"/><bind nodeset="/data/manifest/manifest_row/sampling_method" type="string" required="true()"/><bind nodeset="/data/manifest/manifest_row/sampling_method_other" type="string" required="true()" relevant=" ../sampling_method ='6'"/><bind nodeset="/data/manifest/manifest_row/specimen_category" type="string" required="true()"/><bind nodeset="/data/manifest/manifest_row/specimen_category_other" type="string" required="true()" relevant=" ../specimen_category ='99'"/><bind nodeset="/data/manifest/manifest_row/container_qty" type="string" required="true()"/><bind nodeset="/data/manifest/manifest_row/medium" type="string" required="true()"/><bind nodeset="/data/manifest/manifest_row/medium_other" type="string" required="true()" relevant=" ../medium ='99'"/><bind nodeset="/data/manifest/manifest_row/storage_condition" type="string" required="true()"/><bind nodeset="/data/manifest/manifest_row/integrity" type="string"/><bind nodeset="/data/manifest/manifest_row/intake" type="string"/><bind nodeset="/data/manifest/manifest_row/exception_reason" type="string" required=" ../integrity ='2' or  ../intake ='2'"/><bind nodeset="/data/rows_used" type="string" calculate="count( /data/manifest/manifest_row/batch_id )"/><bind nodeset="/data/total_containers" type="int" required="true()" constraint=". &gt;= 1"/><bind nodeset="/data/records_list" type="string" calculate="join(&quot; | &quot;,  /data/manifest/manifest_row/record_id )"/><bind nodeset="/data/form_summary/sum_header" readonly="true()" type="string"/><bind nodeset="/data/form_summary/sum_dispatch" readonly="true()" type="string"/><bind nodeset="/data/form_summary/sum_logger" readonly="true()" type="string" relevant=" /data/sec2_cold_chain/logger_deployed ='1'"/><bind nodeset="/data/form_summary/sum_no_logger" readonly="true()" type="string" relevant=" /data/sec2_cold_chain/logger_deployed ='0'"/><bind nodeset="/data/form_summary/sum_manifest" readonly="true()" type="string"/><bind nodeset="/data/form_summary/sum_breach" readonly="true()" type="string" relevant=" /data/sec2_cold_chain/cold_chain_breach ='2'"/><bind nodeset="/data/form_summary/summary_confirmed" type="string" required="true()" constraint=". = '1'" jr:constraintMsg="Go back and correct the data before submitting"/><bind nodeset="/data/stage1_signoff/stage1_name" type="string" required="true()"/><bind nodeset="/data/stage1_signoff/stage1_signature" type="binary" required="true()"/><bind nodeset="/data/stage1_signoff/stage1_datetime" type="dateTime" required="true()"/><bind nodeset="/data/stage2_signoff/stage2_name" type="string"/><bind nodeset="/data/stage2_signoff/stage2_signature" type="binary"/><bind nodeset="/data/stage2_signoff/stage2_datetime" type="dateTime"/><bind nodeset="/data/stage3_signoff/stage3_name" type="string"/><bind nodeset="/data/stage3_signoff/stage3_signature" type="binary"/><bind nodeset="/data/stage3_signoff/stage3_datetime" type="dateTime"/><bind nodeset="/data/archive_note" readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec1_dispatch/container_id , &quot; - &quot;,  /data/sec1_dispatch/dispatch_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># SPEC-HND: Sample Handover and Custody</label></input><group appearance="field-list" ref="/data/sec1_routing"><label>Consignment Routing &amp; Origin Node</label><input ref="/data/sec1_routing/node_code"><label>Originating Node Code</label></input><input ref="/data/sec1_routing/destination_lab"><label>Destination Laboratory</label></input><input ref="/data/sec1_routing/waybill_id"><label>Courier / Transport Waybill ID</label></input></group><group appearance="field-list" ref="/data/sec1_dispatch"><label>Shipment Batch &amp; Dispatch Event</label><input ref="/data/sec1_dispatch/dispatch_date"><label>Dispatch Date</label></input><input ref="/data/sec1_dispatch/dispatch_time"><label>Dispatch Time</label></input><input ref="/data/sec1_dispatch/officer_id"><label>Dispatcher ID (registered staff ID)</label><hint>Your registered staff ID, not your name</hint></input><input ref="/data/sec1_dispatch/container_id"><label>Shipping Container ID</label></input></group><group appearance="field-list" ref="/data/sec2_cold_chain"><label>Cold Chain Checks &amp; Temperature</label><input ref="/data/sec2_cold_chain/dispatch_temp"><label>Dispatch temperature (field origin, °C)</label><hint>Record cooler temperature at departure</hint></input><input ref="/data/sec2_cold_chain/dispatch_initials"><label>Initials</label></input><input ref="/data/sec2_cold_chain/receipt_temp"><label>Lab receipt temperature (intake, °C)</label><hint>Completed at the laboratory. Record the reading on arrival and assess it against the approved requirements for this shipment.</hint></input><input ref="/data/sec2_cold_chain/receipt_initials"><label>Initials</label></input><select1 ref="/data/sec2_cold_chain/cold_chain_breach"><label>Cold chain breach / thaw indicator</label><hint>Completed at the laboratory. Flag if ice packs completely melted or indicator spiked</hint><itemset nodeset="instance('cold_chain')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_cold_chain/logger_deployed"><label>Electronic logger deployed?</label><hint>Verify continuous USB/BLE datalogger enclosed in shipper</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_cold_chain/logger_id"><label>Logger ID</label></input></group><input ref="/data/manifest_note"><label>Link each row to its SPEC-SRT collection record ID or HAB-SRV vial ID; site, trap and collection date come from that record. Use separate rows when material in one shipment has different media or conditions.</label></input><input ref="/data/num_rows"><label>Number of manifest rows in this container</label></input><group ref="/data/manifest"><label>Specimen Manifest</label><repeat nodeset="/data/manifest" jr:count=" /data/num_rows "><group appearance="field-list" ref="/data/manifest/manifest_row"><label> Manifest row <output value=" ../row_number "/> </label><input ref="/data/manifest/manifest_row/batch_id"><label>Plate / box barcode or batch ID</label></input><input ref="/data/manifest/manifest_row/record_id"><label>Collection record ID (SPEC-SRT) or larval vial ID (HAB-SRV)</label><hint>SPEC-SRT: Trap ID-YYYYMMDD (a BG bag adds -D or -N), e.g. HH001-CDC-IN-20261120. HAB-SRV: the vial ID.</hint></input><select1 ref="/data/manifest/manifest_row/sampling_method"><label>Sampling method</label><itemset nodeset="instance('sampling_method')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/manifest/manifest_row/sampling_method_other"><label>Specify other sampling method</label></input><select1 ref="/data/manifest/manifest_row/specimen_category"><label>Specimen category</label><itemset nodeset="instance('specimen_category')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/manifest/manifest_row/specimen_category_other"><label>Specify other taxa or category</label></input><input ref="/data/manifest/manifest_row/container_qty"><label>Container and quantity</label><hint>e.g. 1 plate</hint></input><select1 ref="/data/manifest/manifest_row/medium"><label>Medium at dispatch</label><itemset nodeset="instance('medium')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/manifest/manifest_row/medium_other"><label>Specify other medium</label></input><input ref="/data/manifest/manifest_row/storage_condition"><label>Storage condition</label><hint>e.g. Chilled. Record frozen here.</hint></input><select1 ref="/data/manifest/manifest_row/integrity"><label>Physical integrity</label><hint>Completed at the laboratory</hint><itemset nodeset="instance('integrity')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/manifest/manifest_row/intake"><label>Lab intake status</label><hint>Completed at the laboratory</hint><itemset nodeset="instance('intake')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/manifest/manifest_row/exception_reason"><label>Exception or intake reason</label><hint>Describe any leak / damage, or the reason for hold or rejection.</hint></input></group></repeat></group><input ref="/data/total_containers"><label>Total containers in this shipment</label></input><group appearance="field-list" ref="/data/form_summary"><label>Review Before Submitting</label><input ref="/data/form_summary/sum_header"><label>## Shipment Summary</label></input><input ref="/data/form_summary/sum_dispatch"><label> **Container:** <output value=" /data/sec1_dispatch/container_id "/> | **To:** <output value=" /data/sec1_routing/destination_lab "/> | **Waybill:** <output value=" /data/sec1_routing/waybill_id "/>&lt;br&gt;**Dispatched:** <output value=" /data/sec1_dispatch/dispatch_date "/> <output value=" /data/sec1_dispatch/dispatch_time "/> | **Temperature:** <output value=" /data/sec2_cold_chain/dispatch_temp "/> °C </label></input><input ref="/data/form_summary/sum_logger"><label> **Logger:** <output value=" /data/sec2_cold_chain/logger_id "/> </label></input><input ref="/data/form_summary/sum_no_logger"><label>**No electronic logger in this container**</label></input><input ref="/data/form_summary/sum_manifest"><label> **Manifest rows:** <output value=" /data/rows_used "/> | **Containers in shipment:** <output value=" /data/total_containers "/>&lt;br&gt;**Records:** <output value=" /data/records_list "/> </label></input><input ref="/data/form_summary/sum_breach"><label>**WARNING:** Cold chain breach recorded at receipt.</label></input><select1 ref="/data/form_summary/summary_confirmed"><label>I have reviewed this summary and the data are correct</label><hint>If anything is wrong, go back and correct it first</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group appearance="field-list" ref="/data/stage1_signoff"><label>1. Relinquished by (Field Dispatcher)</label><input ref="/data/stage1_signoff/stage1_name"><label>Full name &amp; organisation</label></input><upload ref="/data/stage1_signoff/stage1_signature" mediatype="image/*" appearance="signature"><label>Signature / seal</label></upload><input ref="/data/stage1_signoff/stage1_datetime"><label>Date &amp; time</label></input></group><group appearance="field-list" ref="/data/stage2_signoff"><label>2. Transport Courier / Driver</label><input ref="/data/stage2_signoff/stage2_name"><label>Full name &amp; organisation</label></input><upload ref="/data/stage2_signoff/stage2_signature" mediatype="image/*" appearance="signature"><label>Signature / seal</label></upload><input ref="/data/stage2_signoff/stage2_datetime"><label>Date &amp; time</label></input></group><group appearance="field-list" ref="/data/stage3_signoff"><label>3. Received by (Central Lab Officer)</label><input ref="/data/stage3_signoff/stage3_name"><label>Full name &amp; organisation</label></input><upload ref="/data/stage3_signoff/stage3_signature" mediatype="image/*" appearance="signature"><label>Signature / seal</label></upload><input ref="/data/stage3_signoff/stage3_datetime"><label>Date &amp; time</label></input></group><input ref="/data/archive_note"><label>Retain the signed form in the local observatory archive.</label></input></h:body></h:html>