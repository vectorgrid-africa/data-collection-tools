<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>SPEC-DIS: Mosquito Dissection and Parity</h:title><model odk:xforms-version="1.0.0"><instance><data id="vg_spec_dis" version="2026112015"><start/><end/><today/><deviceid/><username/><form_header/><source_rule/><sec1_source><village/><from_trap/><trap/><source_household_site/><collection_record_id/></sec1_source><node_code/><trap_id/><site_id/><trap_note/><node_code_typed/><sec1_bench><dissection_date/><collection_date/><dissector_id/><start_time/></sec1_bench><num_specimens/><specimens jr:template=""><specimen_num/><specimen_data><specimen_id/><q01_species/><q02_midgut/><q03_insemination/><q04_parity/><q05_egg_stage/><q05_sac_stage/><q06_dilatations/><q06_wing_length/><q07_condition/><sample_tube/></specimen_data></specimens><specimens><specimen_num/><specimen_data><specimen_id/><q01_species/><q02_midgut/><q03_insemination/><q04_parity/><q05_egg_stage/><q05_sac_stage/><q06_dilatations/><q06_wing_length/><q07_condition/><sample_tube/></specimen_data></specimens><total_dissected/><total_parous/><total_nulliparous/><parity_rate/><sec4_summary/><session_notes/><meta><instanceID/><instanceName/></meta></data></instance><instance id="traps" src="jr://file-csv/traps.csv"/><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="species"><root><item><name>1</name><label>An. gambiae s.l.</label></item><item><name>2</name><label>An. funestus group</label></item><item><name>3</name><label>Other Anopheline</label></item></root></instance><instance id="midgut"><root><item><name>1</name><label>No blood (unfed)</label></item><item><name>2</name><label>Fresh blood</label></item><item><name>3</name><label>Brown blood</label></item></root></instance><instance id="insemination"><root><item><name>1</name><label>Positive (sperm present)</label></item><item><name>0</name><label>Negative (empty / no sperm)</label></item></root></instance><instance id="parity"><root><item><name>1</name><label>Parous (uncoiled tracheoles)</label></item><item><name>2</name><label>Nulliparous (coiled skeins)</label></item></root></instance><instance id="egg_stage"><root><item><name>1</name><label>I</label></item><item><name>2</name><label>IIe</label></item><item><name>3</name><label>II</label></item><item><name>4</name><label>III</label></item><item><name>5</name><label>IV</label></item><item><name>6</name><label>V</label></item></root></instance><instance id="condition"><root><item><name>1</name><label>Fresh (dissected immediately)</label></item><item><name>2</name><label>Dry (rehydrated specimen)</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/source_rule" readonly="true()" type="string"/><bind nodeset="/data/sec1_source/village" type="string" required="true()"/><bind nodeset="/data/sec1_source/from_trap" type="string" required="true()"/><bind nodeset="/data/sec1_source/trap" type="string" required="true()" relevant=" /data/sec1_source/from_trap ='1'"/><bind nodeset="/data/sec1_source/source_household_site" type="string" required="true()" relevant=" /data/sec1_source/from_trap ='0'"/><bind nodeset="/data/sec1_source/collection_record_id" type="string" required="true()"/><bind nodeset="/data/node_code" type="string" calculate="instance('traps')/root/item[name= /data/sec1_source/trap ]/node_code"/><bind nodeset="/data/trap_id" type="string" calculate="instance('traps')/root/item[name= /data/sec1_source/trap ]/trap_id"/><bind nodeset="/data/site_id" type="string" calculate="instance('traps')/root/item[name= /data/sec1_source/trap ]/site_id"/><bind nodeset="/data/trap_note" readonly="true()" type="string" relevant=" /data/sec1_source/trap  != ''"/><bind nodeset="/data/node_code_typed" type="string" required="true()" relevant=" /data/sec1_source/from_trap ='0'"/><bind nodeset="/data/sec1_bench/dissection_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future"/><setvalue ref="/data/sec1_bench/dissection_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/sec1_bench/collection_date" type="date" required="true()" constraint=". &lt;=  /data/sec1_bench/dissection_date " jr:constraintMsg="Collection date cannot be after the dissection date"/><bind nodeset="/data/sec1_bench/dissector_id" type="string" required="true()"/><bind nodeset="/data/sec1_bench/start_time" type="time" required="true()"/><bind nodeset="/data/num_specimens" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 100" jr:constraintMsg="Enter 1-100"/><bind nodeset="/data/specimens/specimen_num" type="string" calculate="position(..)"/><bind nodeset="/data/specimens/specimen_data/specimen_id" type="string" required="true()"/><bind nodeset="/data/specimens/specimen_data/q01_species" type="string" required="true()"/><bind nodeset="/data/specimens/specimen_data/q02_midgut" type="string" required="true()"/><bind nodeset="/data/specimens/specimen_data/q03_insemination" type="string" required="true()"/><bind nodeset="/data/specimens/specimen_data/q04_parity" type="string" required="true()"/><bind nodeset="/data/specimens/specimen_data/q05_egg_stage" type="string" required="true()"/><bind nodeset="/data/specimens/specimen_data/q05_sac_stage" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 7" jr:constraintMsg="Enter 0-7"/><bind nodeset="/data/specimens/specimen_data/q06_dilatations" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 5" jr:constraintMsg="Enter 0-5"/><bind nodeset="/data/specimens/specimen_data/q06_wing_length" type="decimal" required="true()" constraint=". &gt; 0 and . &lt; 10" jr:constraintMsg="Enter a length between 0 and 10 mm"/><bind nodeset="/data/specimens/specimen_data/q07_condition" type="string" required="true()"/><bind nodeset="/data/specimens/specimen_data/sample_tube" type="string"/><bind nodeset="/data/total_dissected" type="string" calculate="count( /data/specimens/specimen_data/specimen_id )"/><bind nodeset="/data/total_parous" type="string" calculate="count( /data/specimens/specimen_data/q04_parity [. = '1'])"/><bind nodeset="/data/total_nulliparous" type="string" calculate="count( /data/specimens/specimen_data/q04_parity [. = '2'])"/><bind nodeset="/data/parity_rate" type="string" calculate="if( /data/total_parous  +  /data/total_nulliparous  &gt; 0, round(100 *  /data/total_parous  div ( /data/total_parous  +  /data/total_nulliparous ), 1), &quot;&quot;)"/><bind nodeset="/data/sec4_summary" readonly="true()" type="string"/><bind nodeset="/data/session_notes" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec1_source/collection_record_id , &quot; - &quot;,  /data/sec1_bench/dissection_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># SPEC-DIS: Mosquito Dissection and Parity</label></input><input ref="/data/source_rule"><label>Use one source collection record per submission, including the BG portion where applicable.</label></input><group appearance="field-list" ref="/data/sec1_source"><label>Section 1A: Study node &amp; site links</label><input ref="/data/sec1_source/village"><label>Village ID</label><hint>Type it as on TRAP-REG; the trap list is filtered by it.</hint></input><select1 ref="/data/sec1_source/from_trap"><label>Are the specimens from a trap catch?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec1_source/trap" appearance="search"><label>Source Trap ID</label><itemset nodeset="instance('traps')/root/item[village= /data/sec1_source/village ]"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec1_source/source_household_site"><label>Source household / site ID</label></input><input ref="/data/sec1_source/collection_record_id"><label>SPEC-SRT collection record ID</label><hint>Q05 on SPEC-SRT</hint></input></group><input ref="/data/trap_note"><label> Node: <output value=" /data/node_code "/> | Trap: <output value=" /data/trap_id "/> <output value=" /data/site_id "/> </label></input><input ref="/data/node_code_typed"><label>Node Code</label></input><group appearance="field-list" ref="/data/sec1_bench"><label>Section 1B: Dissection bench event &amp; specimen source</label><input ref="/data/sec1_bench/dissection_date"><label>Dissection Date</label></input><input ref="/data/sec1_bench/collection_date"><label>Source Collection Date</label></input><input ref="/data/sec1_bench/dissector_id"><label>Dissector / team ID</label></input><input ref="/data/sec1_bench/start_time"><label>Dissection Start Time</label></input></group><input ref="/data/num_specimens"><label>Number of specimens dissected</label></input><group ref="/data/specimens"><label>Section 2: Dissection</label><repeat nodeset="/data/specimens" jr:count=" /data/num_specimens "><group appearance="field-list" ref="/data/specimens/specimen_data"><label> Specimen <output value=" ../specimen_num "/> </label><input ref="/data/specimens/specimen_data/specimen_id"><label>Unique specimen ID (from specimen register)</label></input><select1 ref="/data/specimens/specimen_data/q01_species"><label>Q01. Anopheles species</label><itemset nodeset="instance('species')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/specimens/specimen_data/q02_midgut"><label>Q02. Midgut blood content</label><itemset nodeset="instance('midgut')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/specimens/specimen_data/q03_insemination"><label>Q03. Spermatheca insemination</label><itemset nodeset="instance('insemination')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/specimens/specimen_data/q04_parity"><label>Q04. Ovarian parity status</label><itemset nodeset="instance('parity')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/specimens/specimen_data/q05_egg_stage"><label>Q05. Christophers egg stage</label><itemset nodeset="instance('egg_stage')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/specimens/specimen_data/q05_sac_stage"><label>Q05. Sac stage (0-7)</label></input><input ref="/data/specimens/specimen_data/q06_dilatations"><label>Q06. Max dilatations (0-5)</label></input><input ref="/data/specimens/specimen_data/q06_wing_length"><label>Q06. Wing length (mm)</label></input><select1 ref="/data/specimens/specimen_data/q07_condition"><label>Q07. Specimen condition</label><itemset nodeset="instance('condition')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/specimens/specimen_data/sample_tube"><label>Sample tube / plate well</label><hint>Barcode / Well ID / Notes</hint></input></group></repeat></group><input ref="/data/sec4_summary"><label> ## Section 4: Summary

Total dissected: <output value=" /data/total_dissected "/>

Total parous (1): <output value=" /data/total_parous "/>

Total nulliparous (2): <output value=" /data/total_nulliparous "/>

**Parity rate: <output value=" /data/parity_rate "/> %** </label></input><input ref="/data/session_notes" appearance="multiline"><label>Session notes</label></input></h:body></h:html>