<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>SPEC-DIS: Mosquito Dissection and Parity</h:title><model odk:xforms-version="1.0.0"><instance><data id="vg_spec_dis" version="2026112401"><start/><end/><today/><deviceid/><username/><form_header/><session_info><dissection_date/><start_time/><technician/></session_info><sample_selection><from_trap/><district/></sample_selection><at_household/><household_selection><household/><household_label/></household_selection><trap_selection><trap/><trap_label/><trap_id/><trap_method/><node_code/><bg_bag/></trap_selection><other_source><source_vial/><source_household_site/><node_code_typed/></other_source><collection_date/><collection_record_id/><collection_id_note/><num_species/><species_repeat jr:template=""><species_num/><species_info><species/><species_other/><num_specimens/></species_info><specimen_repeat jr:template=""><specimen_num/><specimen_id/><specimen_data><specimen_header/><midgut/><spermatheca/><parity/><egg_stage/><sac_stage/><max_dilatation/><wing_length/><condition/><sample_tube/><specimen_notes/></specimen_data></specimen_repeat></species_repeat><species_repeat><species_num/><species_info><species/><species_other/><num_specimens/></species_info><specimen_repeat><specimen_num/><specimen_id/><specimen_data><specimen_header/><midgut/><spermatheca/><parity/><egg_stage/><sac_stage/><max_dilatation/><wing_length/><condition/><sample_tube/><specimen_notes/></specimen_data></specimen_repeat></species_repeat><total_dissected/><total_parous/><total_nulliparous/><parity_rate/><summary/><full_name_signature/><notes/><dissection_id/><meta><instanceID/><instanceName/></meta></data></instance><instance id="households" src="jr://file-csv/households.csv"/><instance id="traps" src="jr://file-csv/traps.csv"/><instance id="yes_no"><root><item><name>1</name><label>Yes</label></item><item><name>0</name><label>No</label></item></root></instance><instance id="anopheles_species"><root><item><name>an_gambiae</name><label>Anopheles gambiae</label></item><item><name>an_funestus</name><label>Anopheles funestus</label></item><item><name>an_pharoensis</name><label>Anopheles pharoensis</label></item><item><name>an_squamosus</name><label>Anopheles squamosus</label></item><item><name>an_coustani</name><label>Anopheles coustani</label></item><item><name>an_distinctus</name><label>Anopheles distinctus</label></item><item><name>an_ziemanni</name><label>Anopheles ziemanni</label></item><item><name>an_maculipalpis</name><label>Anopheles maculipalpis</label></item><item><name>an_rufipes</name><label>Anopheles rufipes</label></item><item><name>an_rhodesiensis</name><label>Anopheles rhodesiensis</label></item><item><name>an_implexus</name><label>Anopheles implexus</label></item><item><name>an_longipalpis</name><label>Anopheles longipalpis</label></item><item><name>an_christyi</name><label>Anopheles christyi</label></item><item><name>an_wellcomei</name><label>Anopheles wellcomei</label></item><item><name>an_swahilicus</name><label>Anopheles swahilicus</label></item><item><name>other</name><label>Other (specify)</label></item></root></instance><instance id="bg_bag"><root><item><name>D</name><label>Day bag (daytime catch)</label></item><item><name>N</name><label>Night bag (night catch)</label></item></root></instance><instance id="midgut_status"><root><item><name>nb</name><label>No blood</label></item><item><name>fb</name><label>Fresh blood</label></item><item><name>bb</name><label>Brown blood</label></item></root></instance><instance id="spermatheca_status"><root><item><name>positive</name><label>Positive (sperm present)</label></item><item><name>negative</name><label>Negative (no sperm)</label></item></root></instance><instance id="parity_status"><root><item><name>parous</name><label>Parous</label></item><item><name>nulliparous</name><label>Nulliparous</label></item></root></instance><instance id="egg_stage"><root><item><name>stage1</name><label>I</label></item><item><name>stage2e</name><label>IIe</label></item><item><name>stage2</name><label>II</label></item><item><name>stage3</name><label>III</label></item><item><name>stage4</name><label>IV</label></item><item><name>stage5</name><label>V</label></item></root></instance><instance id="specimen_condition"><root><item><name>fresh</name><label>Fresh</label></item><item><name>dry</name><label>Dry</label></item></root></instance><instance id="district"><root><item><name>kilombero</name><label>Kilombero</label></item><item><name>malinyi</name><label>Malinyi</label></item><item><name>mlimba</name><label>Mlimba</label></item><item><name>ulanga</name><label>Ulanga</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/form_header" readonly="true()" type="string"/><bind nodeset="/data/session_info/dissection_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date cannot be in the future"/><setvalue ref="/data/session_info/dissection_date" event="odk-instance-first-load" value=" /data/today "/><bind nodeset="/data/session_info/start_time" type="time" required="true()"/><bind nodeset="/data/session_info/technician" type="string" required="true()"/><bind nodeset="/data/sample_selection/from_trap" type="string" required="true()"/><bind nodeset="/data/sample_selection/district" type="string" required="true()" relevant=" /data/sample_selection/from_trap ='1'"/><bind nodeset="/data/at_household" type="string" required="true()" relevant=" /data/sample_selection/from_trap ='1'"/><bind nodeset="/data/household_selection" relevant=" /data/sample_selection/from_trap ='1' and  /data/at_household ='1'"/><bind nodeset="/data/household_selection/household" type="string" required="true()"/><bind nodeset="/data/household_selection/household_label" type="string" calculate="instance('households')/root/item[name= /data/household_selection/household ]/label"/><bind nodeset="/data/trap_selection" relevant=" /data/sample_selection/from_trap ='1'"/><bind nodeset="/data/trap_selection/trap" type="string" required="true()"/><bind nodeset="/data/trap_selection/trap_label" type="string" calculate="instance('traps')/root/item[name= /data/trap_selection/trap ]/label"/><bind nodeset="/data/trap_selection/trap_id" type="string" calculate="instance('traps')/root/item[name= /data/trap_selection/trap ]/trap_id"/><bind nodeset="/data/trap_selection/trap_method" type="string" calculate="instance('traps')/root/item[name= /data/trap_selection/trap ]/method"/><bind nodeset="/data/trap_selection/node_code" type="string" calculate="instance('traps')/root/item[name= /data/trap_selection/trap ]/node_code"/><bind nodeset="/data/trap_selection/bg_bag" type="string" required="true()" relevant=" /data/trap_selection/trap_method ='BGS'"/><bind nodeset="/data/other_source" relevant=" /data/sample_selection/from_trap ='0'"/><bind nodeset="/data/other_source/source_vial" type="string" required="true()"/><bind nodeset="/data/other_source/source_household_site" type="string" required="true()"/><bind nodeset="/data/other_source/node_code_typed" type="string" required="true()"/><bind nodeset="/data/collection_date" type="date" required="true()" constraint=". &lt;=  /data/session_info/dissection_date " jr:constraintMsg="Collection date cannot be after the dissection date"/><bind nodeset="/data/collection_record_id" type="string" calculate="concat(if( /data/sample_selection/from_trap ='1',  /data/trap_selection/trap_id ,  /data/other_source/source_vial ), &quot;-&quot;, format-date( /data/collection_date , &quot;%Y%m%d&quot;), if( /data/trap_selection/bg_bag !='', concat(&quot;-&quot;,  /data/trap_selection/bg_bag ), &quot;&quot;))"/><bind nodeset="/data/collection_id_note" readonly="true()" type="string" relevant=" /data/collection_date  != &quot;&quot;"/><bind nodeset="/data/num_species" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 10" jr:constraintMsg="Enter 1-10 species"/><bind nodeset="/data/species_repeat/species_num" type="string" calculate="position(..)"/><bind nodeset="/data/species_repeat/species_info/species" type="string" required="true()"/><bind nodeset="/data/species_repeat/species_info/species_other" type="string" required="true()" relevant=" ../species ='other'"/><bind nodeset="/data/species_repeat/species_info/num_specimens" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 100" jr:constraintMsg="Enter 1-100"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_num" type="string" calculate="position(..)"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_id" type="string" calculate="concat( /data/collection_record_id , &quot;-&quot;, substring-after( ../../species_info/species , &quot;_&quot;), &quot;-&quot;,  ../specimen_num )"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/specimen_header" readonly="true()" type="string"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/midgut" type="string" required="true()"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/spermatheca" type="string" required="true()"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/parity" type="string" required="true()"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/egg_stage" type="string" required="true()"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/sac_stage" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 7" jr:constraintMsg="Enter 0-7"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/max_dilatation" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 5" jr:constraintMsg="Enter 0-5"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/wing_length" type="decimal" required="true()" constraint=". &gt; 0 and . &lt; 10" jr:constraintMsg="Enter valid length"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/condition" type="string" required="true()"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/sample_tube" type="string"/><bind nodeset="/data/species_repeat/specimen_repeat/specimen_data/specimen_notes" type="string"/><bind nodeset="/data/total_dissected" type="string" calculate="count( /data/species_repeat/specimen_repeat/specimen_num )"/><bind nodeset="/data/total_parous" type="string" calculate="count( /data/species_repeat/specimen_repeat/specimen_data/parity [. = 'parous'])"/><bind nodeset="/data/total_nulliparous" type="string" calculate="count( /data/species_repeat/specimen_repeat/specimen_data/parity [. = 'nulliparous'])"/><bind nodeset="/data/parity_rate" type="string" calculate="if( /data/total_parous  +  /data/total_nulliparous  &gt; 0, round(100 *  /data/total_parous  div ( /data/total_parous  +  /data/total_nulliparous ), 1), &quot;&quot;)"/><bind nodeset="/data/summary" readonly="true()" type="string"/><bind nodeset="/data/full_name_signature" type="string" required="true()"/><bind nodeset="/data/notes" type="string"/><bind nodeset="/data/dissection_id" type="string" calculate="concat( /data/collection_record_id , &quot;-DISS&quot;)"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/collection_record_id , &quot; - &quot;,  /data/session_info/dissection_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># SPEC-DIS: Mosquito Dissection and Parity</label></input><group appearance="field-list" ref="/data/session_info"><label>Session Information</label><input ref="/data/session_info/dissection_date"><label>Dissection date</label></input><input ref="/data/session_info/start_time"><label>Dissection start time</label></input><input ref="/data/session_info/technician"><label>Dissector ID (registered staff ID)</label><hint>Your registered staff ID, not your name</hint></input></group><group appearance="field-list" ref="/data/sample_selection"><label>Sample Selection</label><select1 ref="/data/sample_selection/from_trap"><label>Are the specimens from a trap catch?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sample_selection/district" appearance="minimal autocomplete"><label>Select district</label><hint>Filter households and traps by district</hint><itemset nodeset="instance('district')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><select1 ref="/data/at_household"><label>Is the trap at a household?</label><hint>No = outdoor site with no household</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><group ref="/data/household_selection"><label>Household Selection</label><select1 ref="/data/household_selection/household" appearance="search"><label>Select household</label><hint>The household where the trap is placed</hint><itemset nodeset="instance('households')/root/item[district= /data/sample_selection/district ]"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/trap_selection"><label>Trap Selection</label><select1 ref="/data/trap_selection/trap" appearance="search"><label>Select trap</label><itemset nodeset="instance('traps')/root/item[status=&quot;active&quot; and (( /data/at_household ='1' and household_id= /data/household_selection/household ) or ( /data/at_household ='0' and district= /data/sample_selection/district  and household_id=&quot;&quot;))]"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/trap_selection/bg_bag"><label>BG bag</label><hint>The bag this collection came from, as on SPEC-SRT</hint><itemset nodeset="instance('bg_bag')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group appearance="field-list" ref="/data/other_source"><label>Specimen Source</label><input ref="/data/other_source/source_vial"><label>Source vial / habitat ID</label><hint>Larval vial ID, as on SPEC-SRT</hint></input><input ref="/data/other_source/source_household_site"><label>Source household / site ID</label></input><input ref="/data/other_source/node_code_typed"><label>Node Code</label></input></group><input ref="/data/collection_date"><label>Collection date</label><hint>When was the sample collected?</hint></input><input ref="/data/collection_id_note"><label> **Collection ID:** <output value=" /data/collection_record_id "/> </label><hint>It should match the Collection ID on the SPEC-SRT review screen.</hint></input><input ref="/data/num_species"><label>How many species to dissect?</label><hint>Enter the number of different species</hint></input><group ref="/data/species_repeat"><label>Species Dissection</label><repeat nodeset="/data/species_repeat" jr:count=" /data/num_species "><group appearance="field-list" ref="/data/species_repeat/species_info"><label> Species <output value=" ../species_num "/> Details </label><select1 ref="/data/species_repeat/species_info/species" appearance="minimal search"><label>Select species</label><itemset nodeset="instance('anopheles_species')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/species_repeat/species_info/species_other"><label>Specify other species</label></input><input ref="/data/species_repeat/species_info/num_specimens"><label>Number of specimens to dissect</label></input></group><group ref="/data/species_repeat/specimen_repeat"><label>Specimen Dissection</label><repeat nodeset="/data/species_repeat/specimen_repeat" jr:count=" ../species_info/num_specimens "><group appearance="field-list" ref="/data/species_repeat/specimen_repeat/specimen_data"><label> Specimen <output value=" ../specimen_num "/>: <output value=" ../specimen_id "/> </label><input ref="/data/species_repeat/specimen_repeat/specimen_data/specimen_header"><label> **Specimen ID: <output value=" ../../specimen_id "/>** </label></input><select1 ref="/data/species_repeat/specimen_repeat/specimen_data/midgut"><label>Midgut content</label><itemset nodeset="instance('midgut_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/species_repeat/specimen_repeat/specimen_data/spermatheca"><label>Spermatheca</label><itemset nodeset="instance('spermatheca_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/species_repeat/specimen_repeat/specimen_data/parity"><label>Parity status</label><itemset nodeset="instance('parity_status')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/species_repeat/specimen_repeat/specimen_data/egg_stage"><label>Egg stage (Christophers)</label><itemset nodeset="instance('egg_stage')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/species_repeat/specimen_repeat/specimen_data/sac_stage"><label>Sac stage (0-7)</label></input><input ref="/data/species_repeat/specimen_repeat/specimen_data/max_dilatation"><label>Max dilatation count (0-5)</label></input><input ref="/data/species_repeat/specimen_repeat/specimen_data/wing_length"><label>Wing length (mm)</label></input><select1 ref="/data/species_repeat/specimen_repeat/specimen_data/condition"><label>Specimen condition</label><itemset nodeset="instance('specimen_condition')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/species_repeat/specimen_repeat/specimen_data/sample_tube"><label>Sample tube / plate well</label><hint>Barcode / Well ID</hint></input><input ref="/data/species_repeat/specimen_repeat/specimen_data/specimen_notes"><label>Notes</label></input></group></repeat></group></repeat></group><input ref="/data/summary"><label> ## Summary

Total dissected: <output value=" /data/total_dissected "/> | Parous: <output value=" /data/total_parous "/> | Nulliparous: <output value=" /data/total_nulliparous "/>

**Parity rate: <output value=" /data/parity_rate "/> %** </label></input><input ref="/data/full_name_signature"><label>Dissected by (full name)</label><hint>Enter your full name</hint></input><input ref="/data/notes" appearance="multiline"><label>Session notes</label></input></h:body></h:html>