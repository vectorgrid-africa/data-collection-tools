entities:saveto="permanence"/><bind nodeset="/data/sec2_classification/q03_habitat_type" type="string" required="true()" entities:saveto="habitat_type"/><bind nodeset="/data/sec2_classification/q03_habitat_type_other" type="string" required="true()" relevant=" /data/sec2_classification/q03_habitat_type ='22'"/><bind nodeset="/data/sec2_classification/q04_length" type="decimal" required="true()" constraint=". &gt; 0"/><bind nodeset="/data/sec2_classification/q04_width" type="decimal" required="true()" constraint=". &gt; 0"/><bind nodeset="/data/sec2_classification/q05_perimeter" type="decimal" required="true()" constraint=". &gt; 0"/><bind nodeset="/data/sec2_classification/area_lw" type="string" calculate="round( /data/sec2_classification/q04_length  *  /data/sec2_classification/q04_width , 1)"/><bind nodeset="/data/sec2_classification/q06_area" type="decimal" required="true()" constraint=". &gt; 0"/><bind nodeset="/data/sec2_classification/q07_depth" type="decimal" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/sec2_classification/q08_movement" type="string" required="true()"/><bind nodeset="/data/sec2_classification/q09_colour" type="string" required="true()"/><bind nodeset="/data/sec2_classification/q09_colour_other" type="string" required="true()" relevant=" /data/sec2_classification/q09_colour ='4'"/><bind nodeset="/data/sec3_vegetation/q10_veg_type" type="string" required="true()"/><bind nodeset="/data/sec3_vegetation/q10_veg_type_other" type="string" required="true()" relevant=" /data/sec3_vegetation/q10_veg_type ='4'"/><bind nodeset="/data/sec3_vegetation/q11_veg_qty" type="string" required="true()" relevant=" /data/sec3_vegetation/q10_veg_type  != '0'"/><bind nodeset="/data/sec3_vegetation/q12_veg_cover" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="Enter 0-100 %" relevant=" /data/sec3_vegetation/q10_veg_type  != '0'"/><bind nodeset="/data/sec3_vegetation/q13_algae_qty" type="string" required="true()"/><bind nodeset="/data/sec3_vegetation/q14_algae_type" type="string" required="true()" relevant=" /data/sec3_vegetation/q13_algae_qty  != '0'"/><bind nodeset="/data/sec3_vegetation/q14_algae_type_other" type="string" required="true()" relevant=" /data/sec3_vegetation/q14_algae_type ='5'"/><bind nodeset="/data/sec3_vegetation/q17_algae_cover" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="Enter 0-100 %" relevant=" /data/sec3_vegetation/q13_algae_qty  != '0'"/><bind nodeset="/data/sec3_vegetation/q15_shade" type="string" required="true()"/><bind nodeset="/data/sec3_vegetation/q17_canopy_cover" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="Enter 0-100 %" relevant=" /data/sec3_vegetation/q15_shade  != '0'"/><bind nodeset="/data/sec3_vegetation/q16_biofilm" type="string" required="true()"/><bind nodeset="/data/sec3_vegetation/q17_biofilm_cover" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="Enter 0-100 %" relevant=" /data/sec3_vegetation/q16_biofilm ='1'"/><bind nodeset="/data/sec3_vegetation/q18_environment" type="string" required="true()"/><bind nodeset="/data/sec3_vegetation/q18_environment_other" type="string" required="true()" relevant=" /data/sec3_vegetation/q18_environment ='9'"/><bind nodeset="/data/sec3_vegetation/q19_distance_homes" type="decimal" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/sec3_vegetation/q20_predators" type="string" required="true()"/><bind nodeset="/data/sec3_vegetation/q20_larvae" type="string" required="true()"/><bind nodeset="/data/status" type="string" calculate="&quot;active&quot;" entities:saveto="status"/><bind nodeset="/data/entity_label" type="string" calculate="concat( /data/sec1_event/habitat_id , &quot; - &quot;,  /data/sec1_geography/village_name )"/><bind nodeset="/data/meta/entity/@create" calculate="true()" readonly="true()" type="string"/><bind nodeset="/data/meta/entity/@id" readonly="true()" type="string"/><setvalue ref="/data/meta/entity/@id" event="odk-instance-first-load" value="uuid()"/><bind nodeset="/data/meta/entity/label" calculate=" /data/entity_label " readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/sec1_event/habitat_id , &quot; - &quot;,  /data/sec1_event/registration_date )"/></model></h:head><h:body><input ref="/data/form_header"><label># HAB-REG: Habitat Registration</label></input><group appearance="field-list" ref="/data/sec1_geography"><label>Section 1A: Administrative geography &amp; study node</label><input ref="/data/sec1_geography/node_code"><label>Node Code</label></input><input ref="/data/sec1_geography/country"><label>Country</label></input><input ref="/data/sec1_geography/province"><label>Province</label></input><input ref="/data/sec1_geography/district"><label>District</label></input><input ref="/data/sec1_geography/locality"><label>Locality</label></input><input ref="/data/sec1_geography/village_name"><label>Site / Village</label></input><input ref="/data/sec1_geography/village"><label>Site / Village ID</label><hint>Type it the same way on every form; habitat lists are filtered by it.</hint></input><input ref="/data/sec1_geography/gps" accuracyThreshold="5"><label>GPS location of habitat</label><hint>Latitude, longitude and altitude. Accuracy within 5 m.</hint></input></group><group appearance="field-list" ref="/data/sec1_event"><label>Section 1B: Habitat inventory &amp; registration event</label><input ref="/data/sec1_event/registration_date"><label>Date of Registration</label></input><input ref="/data/sec1_event/registration_time"><label>Registration Time</label></input><input ref="/data/sec1_event/collector_id"><label>Collector / team ID</label></input><input ref="/data/sec1_event/habitat_id"><label>Habitat Unique ID</label><hint>HAB-...</hint></input></group><group ref="/data/sec2_classification"><label>Section 2: Habitat classification &amp; physical dimensions</label><select1 ref="/data/sec2_classification/q01_natural"><label>Q01. Natural / Artificial</label><itemset nodeset="instance('natural_artificial')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_classification/q02_permanence"><label>Q02. Habitat permanence</label><itemset nodeset="instance('permanence')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_classification/q03_habitat_type" appearance="minimal"><label>Q03. Habitat type</label><itemset nodeset="instance('habitat_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_classification/q03_habitat_type_other"><label>Q03. Specify other habitat type</label></input><input ref="/data/sec2_classification/q04_length"><label>Q04. Habitat surface length (m)</label><hint>Record maximal length and perpendicular width across water body</hint></input><input ref="/data/sec2_classification/q04_width"><label>Q04. Habitat surface width (m)</label></input><input ref="/data/sec2_classification/q05_perimeter"><label>Q05. Habitat perimeter (m)</label><hint>Measure or estimate the distance around the water's edge.</hint></input><input ref="/data/sec2_classification/q06_area"><label>Q06. Estimated total surface area (m²)</label><hint> Total water surface area (Length × Width approximation: <output value=" /data/sec2_classification/area_lw "/> m²) </hint></input><input ref="/data/sec2_classification/q07_depth"><label>Q07. Average water depth (cm)</label><hint>Measured vertical depth of water column in centimetres</hint></input><select1 ref="/data/sec2_classification/q08_movement"><label>Q08. Water movement</label><itemset nodeset="instance('water_movement')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec2_classification/q09_colour"><label>Q09. Water colour</label><itemset nodeset="instance('water_colour')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec2_classification/q09_colour_other"><label>Q09. Specify other water colour</label></input></group><group ref="/data/sec3_vegetation"><label>Section 3: Vegetation, algae &amp; surrounding environment</label><select1 ref="/data/sec3_vegetation/q10_veg_type"><label>Q10. Vegetation type</label><itemset nodeset="instance('vegetation_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_vegetation/q10_veg_type_other"><label>Q10. Specify other vegetation type</label></input><select1 ref="/data/sec3_vegetation/q11_veg_qty"><label>Q11. Vegetation quantity</label><itemset nodeset="instance('vegetation_qty')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_vegetation/q12_veg_cover"><label>Q12. Estimated vegetation cover (%)</label><hint>Visual percentage estimate of water surface occupied by vegetation</hint></input><select1 ref="/data/sec3_vegetation/q13_algae_qty"><label>Q13. Algae quantity</label><itemset nodeset="instance('algae_qty')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_vegetation/q14_algae_type"><label>Q14. Algae type</label><itemset nodeset="instance('algae')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_vegetation/q14_algae_type_other"><label>Q14. Specify other algae type</label></input><input ref="/data/sec3_vegetation/q17_algae_cover"><label>Q17. Estimated algae cover (%)</label><hint>Visual percentage estimate of water surface covered by algae</hint></input><select1 ref="/data/sec3_vegetation/q15_shade"><label>Q15. Shade over habitat</label><itemset nodeset="instance('shade')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_vegetation/q17_canopy_cover"><label>Q17. Canopy cover (%)</label><hint>Estimated percentage of the habitat under canopy</hint></input><select1 ref="/data/sec3_vegetation/q16_biofilm"><label>Q16. Surface biofilm present</label><itemset nodeset="instance('biofilm')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_vegetation/q17_biofilm_cover"><label>Q17. Biofilm cover (%)</label><hint>Visual percentage estimate of water surface covered by biofilm</hint></input><select1 ref="/data/sec3_vegetation/q18_environment"><label>Q18. Environment around habitat</label><itemset nodeset="instance('environment')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sec3_vegetation/q18_environment_other"><label>Q18. Specify other environment</label></input><input ref="/data/sec3_vegetation/q19_distance_homes"><label>Q19. Distance from nearest homes (m)</label><hint>Linear distance from habitat perimeter to nearest household</hint></input><select1 ref="/data/sec3_vegetation/q20_predators"><label>Q20. Aquatic predators present</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sec3_vegetation/q20_larvae"><label>Q20. Larvae / pupae present</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group></h:body></h:html>